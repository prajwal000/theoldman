diff --git a/test/products-name.test.ts b/test/products-name.test.ts
new file mode 100644
index 0000000..1d11f9c
--- /dev/null
+++ b/test/products-name.test.ts
@@ -0,0 +1,15 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/products/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('product name length', () => {
+  it('accepts 200 characters and refuses 201', async () => {
+    const { token } = await createUser('ADMIN');
+    const add = (name: string) =>
+      POST(jsonRequest('/api/products', { body: { name, priceCents: 100 }, token }));
+    expect((await add(` ${'a'.repeat(200)} `)).status).toBe(201);
+    expect((await add('a'.repeat(201))).status).toBe(400);
+  });
+});
