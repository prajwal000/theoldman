@@ -0,0 +1,18 @@
+import { endSession } from '../../../../lib/auth';
+
+/** Where to send the browser afterwards: the `next` path on this site, or the home page. */
+function redirectTarget(request: Request): string {
+  const next = new URL(request.url).searchParams.get('next');
+  return next !== null && next.startsWith('/') ? next : '/';
+}
+
+export async function POST(request: Request): Promise<Response> {
+  await endSession(request);
+  return new Response(null, {
+    status: 303,
+    headers: {
+      location: redirectTarget(request),
+      'set-cookie': 'session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax',
+    },
+  });
+}
