+/** Deletes the session the request is signed in with, if it has one. */
+export async function endSession(request: Request): Promise<void> {
+  const token = sessionToken(request);
+  if (token === undefined) return;
+  await db.session.deleteMany({ where: { tokenHash: hashToken(token) } });
+}
+
 export function publicUser(user: User) {
   return { id: user.id, email: user.email, name: user.name, role: user.role };
 }
diff --git a/test/logout.test.ts b/test/logout.test.ts
new file mode 100644
index 0000000..c6dfb9d
--- /dev/null
+++ b/test/logout.test.ts
@@ -0,0 +1,37 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as logout } from '../src/app/api/auth/logout/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('signing out', () => {
+  it('ends the session and sends the browser to the next page', async () => {
+    const { token } = await createUser();
+    const response = await logout(
+      jsonRequest('/api/auth/logout?next=/orders', { method: 'POST', token }),
+    );
+    expect(response.status).toBe(303);
+    expect(response.headers.get('location')).toBe('/orders');
+    expect((await me(jsonRequest('/api/users/me', { token }))).status).toBe(401);
+  });
+
+  it('sends the browser home without a next page', async () => {
+    const { token } = await createUser();
+    const response = await logout(jsonRequest('/api/auth/logout', { method: 'POST', token }));
+    expect(response.headers.get('location')).toBe('/');
+  });
+
+  it('does not send the browser to another site', async () => {
+    const { token } = await createUser();
+    const response = await logout(
+      jsonRequest('/api/auth/logout?next=https://evil.example/', { method: 'POST', token }),
+    );
+    expect(response.headers.get('location')).toBe('/');
+  });
+
+  it('clears the session cookie', async () => {
+    const response = await logout(jsonRequest('/api/auth/logout', { method: 'POST' }));
+    expect(response.headers.get('set-cookie')).toMatch(/^session=;.*Max-Age=0/);
+  });
+});
