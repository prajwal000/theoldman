@@ -0,0 +1,38 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { DELETE } from '../src/app/api/admin/users/[id]/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function remove(id: string, token: string) {
+  return DELETE(jsonRequest(`/api/admin/users/${id}`, { method: 'DELETE', token }), params({ id }));
+}
+
+describe('deleting an account', () => {
+  it('deletes a customer account and signs it out', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: spammer, token: spamToken } = await createUser();
+    expect((await remove(spammer.id, token)).status).toBe(204);
+    expect(await db.user.findUnique({ where: { id: spammer.id } })).toBeNull();
+    expect((await me(jsonRequest('/api/users/me', { token: spamToken }))).status).toBe(401);
+  });
+
+  it('does not delete admins', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: other } = await createUser('ADMIN');
+    expect((await remove(other.id, token)).status).toBe(409);
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    expect((await remove(other.id, token)).status).toBe(403);
+  });
+
+  it('answers 404 for an unknown account', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await remove('missing', token)).status).toBe(404);
+  });
+});
