@@ -0,0 +1,21 @@
+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+export async function DELETE(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can delete accounts');
+
+  const { id } = await params;
+  const target = await db.user.findUnique({ where: { id } });
+  if (target === null) return jsonError(404, 'account not found');
+  if (target.role === 'ADMIN') return jsonError(409, 'admin accounts cannot be deleted here');
+
+  await db.user.delete({ where: { id } });
+  return new Response(null, { status: 204 });
+}
