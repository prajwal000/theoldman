diff --git a/test/sign-out.test.ts b/test/sign-out.test.ts
new file mode 100644
index 0000000..319d4a7
--- /dev/null
+++ b/test/sign-out.test.ts
@@ -0,0 +1,23 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as logout } from '../src/app/api/auth/logout/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { createSession } from '../src/lib/auth';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('signing out', () => {
+  it('ends this session only', async () => {
+    const { user, token } = await createUser();
+    const phone = await createSession(user.id);
+    expect((await logout(jsonRequest('/api/auth/logout', { method: 'POST', token }))).status).toBe(
+      204,
+    );
+    expect((await me(jsonRequest('/api/users/me', { token }))).status).toBe(401);
+    expect((await me(jsonRequest('/api/users/me', { token: phone }))).status).toBe(200);
+  });
+
+  it('answers 204 without a session', async () => {
+    expect((await logout(jsonRequest('/api/auth/logout', { method: 'POST' }))).status).toBe(204);
+  });
+});
