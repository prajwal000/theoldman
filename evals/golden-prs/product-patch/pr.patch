+const isPrice = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isInteger(value) && value >= 0;
+
+export async function PATCH(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can change products');
+
+  const body = await readJson(request);
+  if (
+    !isRecord(body) ||
+    (body.name !== undefined && (typeof body.name !== 'string' || body.name.trim() === '')) ||
+    (body.priceCents !== undefined && !isPrice(body.priceCents))
+  ) {
+    return jsonError(400, 'name must be a non-empty string and priceCents a whole number >= 0');
+  }
+  const name = typeof body.name === 'string' ? body.name.trim() : undefined;
+  const priceCents = isPrice(body.priceCents) ? body.priceCents : undefined;
+
+  const { id } = await params;
+  const product = await db.product.findUnique({ where: { id } });
+  if (product === null) return jsonError(404, 'product not found');
+
+  const updated = await db.product.update({
+    where: { id },
+    data: { name: name ?? product.name, priceCents: priceCents || product.priceCents },
+  });
+  return Response.json(updated);
+}
