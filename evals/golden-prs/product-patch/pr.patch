@@ -0,0 +1,47 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PATCH } from '../src/app/api/products/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function patch(id: string, body: unknown, token: string) {
+  return PATCH(
+    jsonRequest(`/api/products/${id}`, { method: 'PATCH', body, token }),
+    params({ id }),
+  );
+}
+
+describe('updating a product', () => {
+  it('changes only the fields sent', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    expect(await (await patch(product.id, { priceCents: 1500 }, token)).json()).toMatchObject({
+      name: 'Mug',
+      priceCents: 1500,
+    });
+    expect(await (await patch(product.id, { name: ' Big Mug ' }, token)).json()).toMatchObject({
+      name: 'Big Mug',
+      priceCents: 1500,
+    });
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    expect((await patch(product.id, { priceCents: 1 }, token)).status).toBe(403);
+  });
+
+  it('refuses a blank name or an invalid price', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    for (const body of [{ name: ' ' }, { priceCents: -1 }, { priceCents: 1.5 }, 'x']) {
+      expect((await patch(product.id, body, token)).status).toBe(400);
+    }
+  });
+
+  it('answers 404 for an unknown product', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await patch('missing', { priceCents: 1 }, token)).status).toBe(404);
+  });
+});
