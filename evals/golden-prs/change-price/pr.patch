diff --git a/test/products-price.test.ts b/test/products-price.test.ts
new file mode 100644
index 0000000..ab28ba9
--- /dev/null
+++ b/test/products-price.test.ts
@@ -0,0 +1,68 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PATCH } from '../src/app/api/products/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function patch(id: string, body: unknown, token: string) {
+  return PATCH(
+    jsonRequest(`/api/products/${id}`, { method: 'PATCH', body, token }),
+    params({ id }),
+  );
+}
+
+describe('changing a price', () => {
+  it('lets an admin change a price', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200 },
+    });
+    const response = await patch(product.id, { priceCents: 1500 }, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ id: product.id, priceCents: 1500 });
+    const stored = await db.product.findUnique({ where: { id: product.id } });
+    expect(stored?.priceCents).toBe(1500);
+  });
+
+  it('keeps the totals of existing orders', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200 },
+    });
+    const order = await db.order.create({
+      data: {
+        userId: user.id,
+        productId: product.id,
+        quantity: 2,
+        totalCents: 2400,
+      },
+    });
+    await patch(product.id, { priceCents: 1500 }, token);
+    const stored = await db.order.findUnique({ where: { id: order.id } });
+    expect(stored?.totalCents).toBe(2400);
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200 },
+    });
+    expect((await patch(product.id, { priceCents: 1 }, token)).status).toBe(403);
+  });
+
+  it('refuses a price that is not a whole number the column can hold', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200 },
+    });
+    for (const priceCents of [-1, 1.5, 2_147_483_648, '1500', null]) {
+      expect((await patch(product.id, { priceCents }, token)).status).toBe(400);
+    }
+  });
+
+  it('answers 404 for an unknown product', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await patch('missing', { priceCents: 1 }, token)).status).toBe(404);
+  });
+});
