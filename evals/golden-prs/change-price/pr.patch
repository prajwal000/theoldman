+export async function PATCH(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can change prices');
+
+  const body = await readJson(request);
+  if (
+    !isRecord(body) ||
+    typeof body.priceCents !== 'number' ||
+    !Number.isInteger(body.priceCents) ||
+    body.priceCents < 0 ||
+    body.priceCents > MAX_PRICE_CENTS
+  ) {
+    return jsonError(400, 'priceCents must be a whole number from 0 to 2147483647');
+  }
+  const { id } = await params;
+  const { count } = await db.product.updateMany({
+    where: { id },
+    data: { priceCents: body.priceCents },
+  });
+  if (count === 0) return jsonError(404, 'product not found');
+  return Response.json({ id, priceCents: body.priceCents });
+}
