@@ -0,0 +1,8 @@
+import { db } from '../../../../lib/db';
+
+/** The cheapest and dearest price, for the storefront's price filter; nulls with no products. */
+export async function GET(): Promise<Response> {
+  const products = await db.product.findMany({ select: { priceCents: true } });
+  const prices = products.map((product) => product.priceCents).sort();
+  return Response.json({ minCents: prices[0] ?? null, maxCents: prices.at(-1) ?? null });
+}
