@@ -0,0 +1,19 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/price-range/route';
+import { db } from '../src/lib/db';
+import { resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('price range', () => {
+  it('gives the cheapest and dearest price', async () => {
+    for (const priceCents of [700, 250, 900]) {
+      await db.product.create({ data: { name: 'Item', priceCents } });
+    }
+    expect(await (await GET()).json()).toEqual({ minCents: 250, maxCents: 900 });
+  });
+
+  it('gives nulls when there are no products', async () => {
+    expect(await (await GET()).json()).toEqual({ minCents: null, maxCents: null });
+  });
+});
