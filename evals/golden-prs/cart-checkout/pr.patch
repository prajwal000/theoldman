+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/batch/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function checkout(items: unknown, token: string) {
+  return POST(jsonRequest('/api/orders/batch', { body: { items }, token }));
+}
+
+describe('cart checkout', () => {
+  it('orders every item in the cart', async () => {
+    const { user, token } = await createUser();
+    const mug = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const plate = await db.product.create({ data: { name: 'Plate', priceCents: 900 } });
+    const response = await checkout(
+      [
+        { productId: mug.id, quantity: 2 },
+        { productId: plate.id, quantity: 1 },
+      ],
+      token,
+    );
+    expect(response.status).toBe(201);
+    expect(await response.json()).toMatchObject([
+      { productId: mug.id, quantity: 2, totalCents: 2400 },
+      { productId: plate.id, quantity: 1, totalCents: 900 },
+    ]);
+    expect(await db.order.count({ where: { userId: user.id } })).toBe(2);
+  });
+
+  it('answers 404 for an unknown product', async () => {
+    const { token } = await createUser();
+    expect((await checkout([{ productId: 'missing', quantity: 1 }], token)).status).toBe(404);
+  });
+
+  it('refuses an empty, oversized or malformed cart', async () => {
+    const { token } = await createUser();
+    const tooMany = Array.from({ length: 21 }, () => ({ productId: 'p', quantity: 1 }));
+    for (const items of [[], tooMany, [{ productId: 'p', quantity: 0 }], 'p']) {
+      expect((await checkout(items, token)).status).toBe(400);
+    }
+  });
+});
