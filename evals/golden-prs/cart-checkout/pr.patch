@@ -0,0 +1,59 @@
+import type { Order } from '../../../../generated/prisma/client';
+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../lib/http';
+
+const MAX_ITEMS = 20;
+
+interface Item {
+  readonly productId: string;
+  readonly quantity: number;
+}
+
+function isItem(value: unknown): value is Item {
+  return (
+    isRecord(value) &&
+    typeof value.productId === 'string' &&
+    typeof value.quantity === 'number' &&
+    Number.isInteger(value.quantity) &&
+    value.quantity >= 1
+  );
+}
+
+export async function POST(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const body = await readJson(request);
+  const items: unknown = isRecord(body) ? body.items : undefined;
+  if (
+    !Array.isArray(items) ||
+    items.length === 0 ||
+    items.length > MAX_ITEMS ||
+    !items.every(isItem)
+  ) {
+    return jsonError(400, `items must be a list of 1 to ${MAX_ITEMS} { productId, quantity }`);
+  }
+
+  const products = await db.product.findMany({
+    where: { id: { in: items.map((item) => item.productId) } },
+  });
+  const byId = new Map(products.map((product) => [product.id, product]));
+
+  const orders: Order[] = [];
+  for (const item of items) {
+    const product = byId.get(item.productId);
+    if (product === undefined) return jsonError(404, `product ${item.productId} not found`);
+    orders.push(
+      await db.order.create({
+        data: {
+          userId: user.id,
+          productId: product.id,
+          quantity: item.quantity,
+          totalCents: product.priceCents * item.quantity,
+        },
+      }),
+    );
+  }
+  return Response.json(orders, { status: 201 });
+}
