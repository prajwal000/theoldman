+++ b/test/admin-top-customers.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/top-customers/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function paid(
+  userId: string,
+  productId: string,
+  totalCents: number,
+  status = 'PAID' as const,
+) {
+  await db.order.create({ data: { userId, productId, quantity: 1, totalCents, status } });
+}
+
+describe('top customers', () => {
+  it('ranks customers by what they spent on paid orders', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: ada } = await createUser();
+    const { user: bob } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1000 } });
+    await paid(ada.id, product.id, 1000);
+    await paid(bob.id, product.id, 1500);
+    await paid(ada.id, product.id, 1000);
+    await db.order.create({
+      data: { userId: bob.id, productId: product.id, quantity: 1, totalCents: 9000 },
+    });
+
+    const response = await GET(jsonRequest('/api/admin/top-customers', { token }));
+    expect(await response.json()).toEqual([
+      { id: ada.id, name: ada.name, spentCents: 2000 },
+      { id: bob.id, name: bob.name, spentCents: 1500 },
+    ]);
+    const top = await GET(jsonRequest('/api/admin/top-customers?limit=1', { token }));
+    expect(await top.json()).toEqual([{ id: ada.id, name: ada.name, spentCents: 2000 }]);
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    expect((await GET(jsonRequest('/api/admin/top-customers', { token }))).status).toBe(403);
+  });
+});
