@@ -0,0 +1,25 @@
+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+interface TopCustomer {
+  readonly id: string;
+  readonly name: string;
+  readonly spentCents: number;
+}
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can see top customers');
+
+  const limit = new URL(request.url).searchParams.get('limit') ?? '10';
+  const rows = await db.$queryRawUnsafe<TopCustomer[]>(`
+    SELECT u."id", u."name", SUM(o."totalCents")::int AS "spentCents"
+    FROM "Order" o JOIN "User" u ON u."id" = o."userId"
+    WHERE o."status" = 'PAID'
+    GROUP BY u."id", u."name"
+    ORDER BY "spentCents" DESC
+    LIMIT ${limit}`);
+  return Response.json(rows);
+}
diff --git a/test/admin-top-customers.test.ts b/test/admin-top-customers.test.ts
