+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+export async function DELETE(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const { id } = await params;
+  const { count } = await db.order.deleteMany({
+    where: { id, userId: user.id, status: 'CANCELLED' },
+  });
+  if (count > 0) return new Response(null, { status: 204 });
+  const exists = (await db.order.count({ where: { id, userId: user.id } })) > 0;
+  return exists
+    ? jsonError(409, 'only cancelled orders can be removed')
+    : jsonError(404, 'order not found');
+}
diff --git a/test/orders-remove.test.ts b/test/orders-remove.test.ts
new file mode 100644
