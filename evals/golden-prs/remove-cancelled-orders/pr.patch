--- /dev/null
+++ b/test/orders-remove.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { DELETE } from '../src/app/api/orders/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string, status: 'PENDING' | 'PAID' | 'CANCELLED') {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 1, totalCents: 1200, status },
+  });
+}
+
+function remove(id: string, token: string) {
+  return DELETE(jsonRequest(`/api/orders/${id}`, { method: 'DELETE', token }), params({ id }));
+}
+
+describe('removing a cancelled order', () => {
+  it('removes a cancelled order from the history', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id, 'CANCELLED');
+    expect((await remove(order.id, token)).status).toBe(204);
+    expect(await db.order.findUnique({ where: { id: order.id } })).toBeNull();
+  });
+
+  it('refuses to remove an order that was not cancelled', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id, 'PAID');
+    try {
+      await remove(order.id, token);
+    } catch (error) {
+      expect(String(error)).toMatch(/only cancelled orders/);
+    }
+  });
+
+  it("does not find another customer's order", async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const order = await orderFor(other.id, 'CANCELLED');
+    expect((await remove(order.id, token)).status).toBe(404);
+  });
+});
