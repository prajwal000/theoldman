+++ b/test/health.test.ts
@@ -0,0 +1,24 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { GET } from '../src/app/api/health/route';
+import { db } from '../src/lib/db';
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe('health check', () => {
+  it('answers 200 while the database is reachable', async () => {
+    const response = await GET();
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ ok: true });
+    expect(response.headers.get('cache-control')).toBe('no-store');
+  });
+
+  it('answers 503 when the database is not', async () => {
+    vi.spyOn(console, 'error').mockImplementation(() => undefined);
+    vi.spyOn(db, '$queryRaw').mockRejectedValue(new Error('connection refused'));
+    const response = await GET();
+    expect(response.status).toBe(503);
+    expect(await response.json()).toEqual({ error: 'database unreachable' });
+  });
+});
