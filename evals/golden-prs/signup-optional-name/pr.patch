diff --git a/test/signup-name.test.ts b/test/signup-name.test.ts
new file mode 100644
index 0000000..578b423
--- /dev/null
+++ b/test/signup-name.test.ts
@@ -0,0 +1,29 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as signup } from '../src/app/api/auth/signup/route';
+import { jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function signUp(body: unknown): Promise<{ status: number; name?: string }> {
+  const response = await signup(jsonRequest('/api/auth/signup', { body }));
+  if (response.status !== 201) return { status: response.status };
+  const { user } = (await response.json()) as { user: { name: string } };
+  return { status: 201, name: user.name };
+}
+
+describe('signup name', () => {
+  it('uses the name given', async () => {
+    const body = { email: 'ada@example.com', password: 'analytical engine', name: ' Ada ' };
+    expect(await signUp(body)).toEqual({ status: 201, name: 'Ada' });
+  });
+
+  it('falls back to the start of the email', async () => {
+    const body = { email: 'grace.hopper@example.com', password: 'compiler first' };
+    expect(await signUp(body)).toEqual({ status: 201, name: 'grace.hopper' });
+  });
+
+  it('refuses a name that is not a string', async () => {
+    const body = { email: 'b@example.com', password: 'long enough', name: 42 };
+    expect((await signUp(body)).status).toBe(400);
+  });
+});
