--- /dev/null
+++ b/test/orders-summary.test.ts
@@ -0,0 +1,54 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/summary/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order summary', () => {
+  it('counts paid orders and what was spent on them', async () => {
+    const { user, token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await db.order.create({
+      data: {
+        userId: user.id,
+        productId: product.id,
+        quantity: 2,
+        totalCents: 2400,
+        status: 'PAID',
+      },
+    });
+    await db.order.create({
+      data: {
+        userId: user.id,
+        productId: product.id,
+        quantity: 1,
+        totalCents: 1200,
+        status: 'CANCELLED',
+      },
+    });
+    const response = await GET(jsonRequest('/api/orders/summary', { token }));
+    expect(await response.json()).toEqual({ orders: 1, spentCents: 2400 });
+  });
+
+  it('leaves out other customers', async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await db.order.create({
+      data: {
+        userId: other.id,
+        productId: product.id,
+        quantity: 1,
+        totalCents: 1200,
+        status: 'PAID',
+      },
+    });
+    const response = await GET(jsonRequest('/api/orders/summary', { token }));
+    expect(await response.json()).toEqual({ orders: 0, spentCents: 0 });
+  });
+
+  it('refuses anonymous requests', async () => {
+    expect((await GET(jsonRequest('/api/orders/summary'))).status).toBe(401);
+  });
+});
