diff --git a/src/app/api/orders/summary/route.ts b/src/app/api/orders/summary/route.ts
new file mode 100644
index 0000000..e156629
--- /dev/null
+++ b/src/app/api/orders/summary/route.ts
@@ -0,0 +1,15 @@
+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const summary = await db.order.aggregate({
+    where: { userId: user.id, status: { not: 'CANCELLED' } },
+    _count: true,
+    _sum: { totalCents: true },
+  });
+  return Response.json({ orders: summary._count, spentCents: summary._sum.totalCents ?? 0 });
+}
diff --git a/test/orders-summary.test.ts b/test/orders-summary.test.ts
new file mode 100644
