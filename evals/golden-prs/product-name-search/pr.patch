@@ -0,0 +1,35 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/search/route';
+import { db } from '../src/lib/db';
+import { jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function search(q: string): Promise<{ status: number; names: string[] }> {
+  const response = await GET(jsonRequest(`/api/products/search?q=${encodeURIComponent(q)}`));
+  if (response.status !== 200) return { status: response.status, names: [] };
+  const products = (await response.json()) as { name: string }[];
+  return { status: 200, names: products.map((product) => product.name) };
+}
+
+describe('product search', () => {
+  it('finds products by part of their name, ignoring case', async () => {
+    await db.product.create({ data: { name: 'Blue Mug', priceCents: 1200 } });
+    await db.product.create({ data: { name: 'Red Plate', priceCents: 900 } });
+    expect(await search('mug')).toEqual({ status: 200, names: ['Blue Mug'] });
+  });
+
+  it('lists the newest match first', async () => {
+    await db.product.create({
+      data: { name: 'Old Mug', priceCents: 1, createdAt: new Date(1000) },
+    });
+    await db.product.create({
+      data: { name: 'New Mug', priceCents: 1, createdAt: new Date(2000) },
+    });
+    expect((await search('mug')).names).toEqual(['New Mug', 'Old Mug']);
+  });
+
+  it('asks for a search term', async () => {
+    expect((await search('  ')).status).toBe(400);
+  });
+});
