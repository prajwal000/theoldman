diff --git a/test/orders-cache.test.ts b/test/orders-cache.test.ts
new file mode 100644
index 0000000..3f30b62
--- /dev/null
+++ b/test/orders-cache.test.ts
@@ -0,0 +1,20 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order list caching', () => {
+  it('lets the order list be cached for 30 seconds', async () => {
+    const { token } = await createUser();
+    const response = await GET(jsonRequest('/api/orders', { token }));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('public, max-age=30');
+  });
+
+  it('does not cache the refusal for anonymous requests', async () => {
+    const response = await GET(jsonRequest('/api/orders'));
+    expect(response.status).toBe(401);
+    expect(response.headers.get('cache-control')).toBeNull();
+  });
+});
