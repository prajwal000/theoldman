@@ -0,0 +1,32 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order list', () => {
+  it("shows each product's current price next to what was paid", async () => {
+    const { user, token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const order = await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 2, totalCents: 2400 },
+    });
+    await db.product.update({ where: { id: product.id }, data: { priceCents: 1500 } });
+
+    const response = await GET(jsonRequest('/api/orders', { token }));
+    expect(await response.json()).toMatchObject([
+      { id: order.id, totalCents: 2400, productName: 'Mug', productPriceCents: 1500 },
+    ]);
+  });
+
+  it("lists only the signed-in customer's orders", async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await db.order.create({
+      data: { userId: other.id, productId: product.id, quantity: 1, totalCents: 1200 },
+    });
+    expect(await (await GET(jsonRequest('/api/orders', { token }))).json()).toEqual([]);
+  });
+});
