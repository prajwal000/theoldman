diff --git a/src/app/api/users/me/route.ts b/src/app/api/users/me/route.ts
index e86341b..c085789 100644
--- a/src/app/api/users/me/route.ts
+++ b/src/app/api/users/me/route.ts
@@ -1,8 +1,24 @@
 import { getCurrentUser, publicUser } from '../../../../lib/auth';
-import { jsonError } from '../../../../lib/http';
+import { db } from '../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../lib/http';
+
+const MAX_NAME_LENGTH = 100;
 
 export async function GET(request: Request): Promise<Response> {
   const user = await getCurrentUser(request);
   if (user === null) return jsonError(401, 'sign in first');
   return Response.json({ user: publicUser(user) });
 }
+
+export async function PATCH(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const body = await readJson(request);
+  const name = isRecord(body) && typeof body.name === 'string' ? body.name.trim() : '';
+  if (name === '' || name.length > MAX_NAME_LENGTH) {
+    return jsonError(400, `name must be 1 to ${MAX_NAME_LENGTH} characters`);
+  }
+  const updated = await db.user.update({ where: { id: user.id }, data: { name } });
+  return Response.json({ user: publicUser(updated) });
+}
diff --git a/test/users-me.test.ts b/test/users-me.test.ts
new file mode 100644
index 0000000..30ac2e0
--- /dev/null
+++ b/test/users-me.test.ts
@@ -0,0 +1,32 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PATCH } from '../src/app/api/users/me/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function rename(body: unknown, token?: string) {
+  return PATCH(jsonRequest('/api/users/me', { method: 'PATCH', body, token }));
+}
+
+describe('changing the display name', () => {
+  it.only('changes the name', async () => {
+    const { user, token } = await createUser();
+    const response = await rename({ name: '  Ada Lovelace ' }, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ user: { name: 'Ada Lovelace' } });
+    const stored = await db.user.findUniqueOrThrow({ where: { id: user.id } });
+    expect(stored.name).toBe('Ada Lovelace');
+  });
+
+  it('refuses an empty or very long name', async () => {
+    const { token } = await createUser();
+    for (const name of ['', '   ', 'x'.repeat(101), 42]) {
+      expect((await rename({ name }, token)).status).toBe(400);
+    }
+  });
+
+  it('refuses anonymous requests', async () => {
+    expect((await rename({ name: 'Ada' })).status).toBe(401);
+  });
+});
