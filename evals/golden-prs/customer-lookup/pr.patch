+++ b/src/app/api/admin/users/route.ts
@@ -0,0 +1,19 @@
+import { getCurrentUser, publicUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can look up customers');
+
+  const email = new URL(request.url).searchParams.get('email');
+  if (email === null || email === '') return jsonError(400, 'email is required');
+
+  const customer = await db.user.findUnique({
+    where: { email },
+    include: { _count: { select: { orders: true } } },
+  });
+  if (customer === null) return jsonError(404, 'no customer with that email');
+  return Response.json({ user: publicUser(customer), orders: customer._count.orders });
+}
