+++ b/test/admin-users.test.ts
@@ -0,0 +1,32 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/users/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function lookUp(email: string, token: string) {
+  return GET(jsonRequest(`/api/admin/users?email=${encodeURIComponent(email)}`, { token }));
+}
+
+describe('customer lookup', () => {
+  it('finds a customer by email with their order count', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: customer } = await createUser();
+    const response = await lookUp(customer.email, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      user: { id: customer.id, email: customer.email, name: customer.name, role: 'CUSTOMER' },
+      orders: 0,
+    });
+  });
+
+  it('answers 404 for an unknown email', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await lookUp('nobody@example.com', token)).status).toBe(404);
+  });
+
+  it('refuses customers', async () => {
+    const { user, token } = await createUser();
+    expect((await lookUp(user.email, token)).status).toBe(403);
+  });
+});
