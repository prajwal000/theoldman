@@ -0,0 +1,36 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET as expire } from '../src/app/api/admin/orders/expire/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+describe('expiring stale orders', () => {
+  it('cancels pending orders older than 14 days, and nothing else', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const base = { userId: user.id, productId: product.id, quantity: 1, totalCents: 1200 };
+    const old = new Date(Date.now() - 15 * DAY_MS);
+    const stale = await db.order.create({ data: { ...base, createdAt: old } });
+    const paid = await db.order.create({ data: { ...base, createdAt: old, status: 'PAID' } });
+    const fresh = await db.order.create({
+      data: { ...base, createdAt: new Date(Date.now() - DAY_MS) },
+    });
+
+    const response = await expire(jsonRequest('/api/admin/orders/expire', { token }));
+    expect(await response.json()).toEqual({ cancelled: 1 });
+    const statuses = await db.order.findMany({ select: { id: true, status: true } });
+    expect(Object.fromEntries(statuses.map((o) => [o.id, o.status]))).toEqual({
+      [stale.id]: 'CANCELLED',
+      [paid.id]: 'PAID',
+      [fresh.id]: 'PENDING',
+    });
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    expect((await expire(jsonRequest('/api/admin/orders/expire', { token }))).status).toBe(403);
+  });
+});
