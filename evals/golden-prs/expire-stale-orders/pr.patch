@@ -0,0 +1,19 @@
+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+const STALE_DAYS = 14;
+
+/** Cancels pending orders that were never paid, for the ops dashboard's "expire stale orders" link. */
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can expire orders');
+
+  const cutoff = new Date(Date.now() - STALE_DAYS * 24 * 60 * 60 * 1000);
+  const { count } = await db.order.updateMany({
+    where: { status: 'PENDING', createdAt: { lt: cutoff } },
+    data: { status: 'CANCELLED' },
+  });
+  return Response.json({ cancelled: count });
+}
