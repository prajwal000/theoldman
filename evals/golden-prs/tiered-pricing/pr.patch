+++ b/src/lib/pricing.ts
@@ -0,0 +1,5 @@
+/** Tiered discounts on one product: 5% off 5 or more, 10% off 10 or more, rounded to the cent. */
+export function orderTotal(priceCents: number, quantity: number): number {
+  const percentOff = quantity >= 10 ? 10 : quantity >= 5 ? 5 : 0;
+  return Math.round((priceCents * quantity * (100 - percentOff)) / 100);
+}
diff --git a/test/orders-pricing.test.ts b/test/orders-pricing.test.ts
new file mode 100644
index 0000000..c64f49e
--- /dev/null
+++ b/test/orders-pricing.test.ts
@@ -0,0 +1,22 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { orderTotal } from '../src/lib/pricing';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('tiered pricing', () => {
+  for (const quantity of [1, 4, 5, 9, 10, 25]) {
+    it(`charges the tier price for ${String(quantity)}`, async () => {
+      const { token } = await createUser();
+      const product = await db.product.create({ data: { name: 'Mug', priceCents: 999 } });
+      const response = await POST(
+        jsonRequest('/api/orders', { body: { productId: product.id, quantity }, token }),
+      );
+      expect(response.status).toBe(201);
+      const order = (await response.json()) as { totalCents: number };
+      expect(order.totalCents).toBe(orderTotal(product.priceCents, quantity));
+    });
+  }
+});
