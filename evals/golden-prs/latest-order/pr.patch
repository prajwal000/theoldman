new file mode 100644
index 0000000..bf88911
--- /dev/null
+++ b/test/orders-latest.test.ts
@@ -0,0 +1,31 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/latest/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('latest order', () => {
+  it("returns the customer's most recent order", async () => {
+    const { user, token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 1, totalCents: 1200 },
+    });
+    const latest = await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 2, totalCents: 2400 },
+    });
+    const response = await GET(jsonRequest('/api/orders/latest', { token }));
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ id: latest.id, product: { name: 'Mug' } });
+  });
+
+  it('answers 404 before the first order', async () => {
+    const { token } = await createUser();
+    expect((await GET(jsonRequest('/api/orders/latest', { token }))).status).toBe(404);
+  });
+
+  it('refuses anonymous requests', async () => {
+    expect((await GET(jsonRequest('/api/orders/latest'))).status).toBe(401);
+  });
+});
