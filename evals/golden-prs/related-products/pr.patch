@@ -0,0 +1,37 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/[id]/related/route';
+import { db } from '../src/lib/db';
+import { jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function relatedNames(id: string): Promise<string[]> {
+  const response = await GET(jsonRequest(`/api/products/${id}/related`), params({ id }));
+  return ((await response.json()) as { name: string }[]).map((product) => product.name);
+}
+
+describe('related products', () => {
+  it('lists products within 20% of the price', async () => {
+    const mug = await db.product.create({
+      data: { name: 'Mug', priceCents: 1000, createdAt: new Date(1000) },
+    });
+    for (const [name, priceCents] of [
+      ['Cup', 800],
+      ['Bowl', 1200],
+      ['Teapot', 4000],
+      ['Spoon', 100],
+    ] as const) {
+      await db.product.create({ data: { name, priceCents, createdAt: new Date(2000) } });
+    }
+    expect((await relatedNames(mug.id)).sort()).toEqual(expect.arrayContaining(['Bowl', 'Cup']));
+    expect(await relatedNames(mug.id)).not.toContain('Teapot');
+  });
+
+  it('answers 404 for an unknown product', async () => {
+    const response = await GET(
+      jsonRequest('/api/products/missing/related'),
+      params({ id: 'missing' }),
+    );
+    expect(response.status).toBe(404);
+  });
+});
