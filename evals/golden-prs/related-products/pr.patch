@@ -0,0 +1,28 @@
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+const MAX_RELATED = 5;
+/** "Related" means within 20% of the product's price either way. */
+const PRICE_BAND = 0.2;
+
+export async function GET(_request: Request, { params }: Context): Promise<Response> {
+  const { id } = await params;
+  const product = await db.product.findUnique({ where: { id } });
+  if (product === null) return jsonError(404, 'product not found');
+
+  const related = await db.product.findMany({
+    where: {
+      priceCents: {
+        gte: Math.floor(product.priceCents * (1 - PRICE_BAND)),
+        lte: Math.ceil(product.priceCents * (1 + PRICE_BAND)),
+      },
+    },
+    orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
+    take: MAX_RELATED,
+  });
+  return Response.json(related);
+}
