diff --git a/test/products-edit.test.ts b/test/products-edit.test.ts
new file mode 100644
index 0000000..9a0366a
--- /dev/null
+++ b/test/products-edit.test.ts
@@ -0,0 +1,52 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PUT } from '../src/app/api/products/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function put(id: string, body: unknown, token: string) {
+  return PUT(jsonRequest(`/api/products/${id}`, { method: 'PUT', body, token }), params({ id }));
+}
+
+describe('editing a product', () => {
+  it('lets an admin change the name and price', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const response = await put(product.id, { name: ' Big Mug ', priceCents: 1500 }, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ id: product.id, name: 'Big Mug', priceCents: 1500 });
+    const stored = await db.product.findUniqueOrThrow({ where: { id: product.id } });
+    expect(stored).toMatchObject({ name: 'Big Mug', priceCents: 1500 });
+  });
+
+  it('keeps the totals of existing orders', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const order = await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 1, totalCents: 1200 },
+    });
+    await put(product.id, { name: 'Mug', priceCents: 1500 }, token);
+    const stored = await db.order.findUniqueOrThrow({ where: { id: order.id } });
+    expect(stored.totalCents).toBe(1200);
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    expect((await put(product.id, { name: 'Mug', priceCents: 1 }, token)).status).toBe(403);
+  });
+
+  it('refuses a missing name or price', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    for (const body of [{ priceCents: 1 }, { name: ' ', priceCents: 1 }, { name: 'Mug' }]) {
+      expect((await put(product.id, body, token)).status).toBe(400);
+    }
+  });
+
+  it('answers 404 for an unknown product', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await put('missing', { name: 'Mug', priceCents: 1 }, token)).status).toBe(404);
+  });
+});
