+export async function PUT(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can edit products');
+
+  const body = await readJson(request);
+  if (
+    !isRecord(body) ||
+    typeof body.name !== 'string' ||
+    body.name.trim() === '' ||
+    typeof body.priceCents !== 'number'
+  ) {
+    return jsonError(400, 'name and priceCents are required');
+  }
+  const { id } = await params;
+  const data = { name: body.name.trim(), priceCents: body.priceCents };
+  const { count } = await db.product.updateMany({ where: { id }, data });
+  if (count === 0) return jsonError(404, 'product not found');
+  return Response.json({ id, ...data });
+}
