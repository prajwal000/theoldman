diff --git a/test/orders-email.test.ts b/test/orders-email.test.ts
new file mode 100644
index 0000000..bbd09d4
--- /dev/null
+++ b/test/orders-email.test.ts
@@ -0,0 +1,41 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { outbox } from '../src/lib/email';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(async () => {
+  await resetDatabase();
+  outbox.length = 0;
+  process.env.EMAIL_FROM = 'Shop <orders@shop.example>';
+});
+
+afterEach(() => {
+  delete process.env.EMAIL_FROM;
+});
+
+describe('order confirmation email', () => {
+  it('emails the customer when they place an order', async () => {
+    const { user, token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1250 } });
+    const response = await POST(
+      jsonRequest('/api/orders', { body: { productId: product.id, quantity: 2 }, token }),
+    );
+    expect(response.status).toBe(201);
+    const { id } = (await response.json()) as { id: string };
+    expect(outbox).toEqual([
+      {
+        from: 'Shop <orders@shop.example>',
+        to: user.email,
+        subject: 'Your order of Mug',
+        text: `Thanks for your order: 2 x Mug, 25.00 in total. Order ${id}.`,
+      },
+    ]);
+  });
+
+  it('sends nothing when the order fails', async () => {
+    const { token } = await createUser();
+    await POST(jsonRequest('/api/orders', { body: { productId: 'missing', quantity: 1 }, token }));
+    expect(outbox).toEqual([]);
+  });
+});
