@@ -0,0 +1,42 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/sales/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function paidOrder(userId: string, productId: string, at: string, totalCents: number) {
+  await db.order.create({
+    data: { userId, productId, quantity: 1, totalCents, status: 'PAID', createdAt: new Date(at) },
+  });
+}
+
+describe('sales report', () => {
+  it('totals the paid orders of the days asked for', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await paidOrder(user.id, product.id, '2026-11-02T08:00:00Z', 1200);
+    await paidOrder(user.id, product.id, '2026-11-02T23:59:00Z', 2400);
+    await paidOrder(user.id, product.id, '2026-11-03T00:00:00Z', 9900);
+    await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 1, totalCents: 500 },
+    });
+    const response = await GET(
+      jsonRequest('/api/admin/sales?from=2026-11-02&to=2026-11-02', { token }),
+    );
+    expect(await response.json()).toEqual({ orders: 2, totalCents: 3600 });
+  });
+
+  it('refuses a missing or malformed day', async () => {
+    const { token } = await createUser('ADMIN');
+    for (const query of ['', '?from=yesterday&to=2026-11-02', '?from=2026-02-30&to=2026-03-01']) {
+      expect((await GET(jsonRequest(`/api/admin/sales${query}`, { token }))).status).toBe(400);
+    }
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    const url = '/api/admin/sales?from=2026-11-02&to=2026-11-02';
+    expect((await GET(jsonRequest(url, { token }))).status).toBe(403);
+  });
+});
