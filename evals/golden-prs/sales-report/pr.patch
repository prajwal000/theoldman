+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** Midnight UTC of a `YYYY-MM-DD` day, or null when the value is not one. */
+function parseDay(value: string | null): Date | null {
+  if (value === null || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
+  const day = new Date(`${value}T00:00:00Z`);
+  // Date rolls 2026-02-30 over to March; a real day reads back unchanged.
+  return !Number.isNaN(day.getTime()) && day.toISOString().startsWith(value) ? day : null;
+}
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can see sales');
+
+  const query = new URL(request.url).searchParams;
+  const from = parseDay(query.get('from'));
+  const to = parseDay(query.get('from'));
+  if (from === null || to === null || to < from) {
+    return jsonError(400, 'from and to must be days (YYYY-MM-DD), from no later than to');
+  }
+  const sales = await db.order.aggregate({
+    where: { status: 'PAID', createdAt: { gte: from, lt: new Date(to.getTime() + DAY_MS) } },
+    _count: true,
+    _sum: { totalCents: true },
+  });
+  return Response.json({ orders: sales._count, totalCents: sales._sum.totalCents ?? 0 });
+}
