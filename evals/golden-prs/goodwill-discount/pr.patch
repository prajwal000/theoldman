+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/admin/orders/[id]/discount/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string, status: 'PENDING' | 'PAID' = 'PENDING') {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1999 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 1, totalCents: 1999, status },
+  });
+}
+
+function discount(id: string, percentOff: unknown, token: string) {
+  return POST(
+    jsonRequest(`/api/admin/orders/${id}/discount`, { body: { percentOff }, token }),
+    params({ id }),
+  );
+}
+
+describe('goodwill discount', () => {
+  it('takes a percentage off a pending order, rounded to the cent', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const order = await orderFor(user.id);
+    const response = await discount(order.id, 15, token);
+    expect(await response.json()).toEqual({ id: order.id, totalCents: 1699 });
+    const stored = await db.order.findUniqueOrThrow({ where: { id: order.id } });
+    expect(stored.totalCents).toBe(1699);
+  });
+
+  it('refuses a paid order', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const order = await orderFor(user.id, 'PAID');
+    expect((await discount(order.id, 10, token)).status).toBe(409);
+  });
+
+  it('refuses a percentage that is not a whole number', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const order = await orderFor(user.id);
+    expect((await discount(order.id, 12.5, token)).status).toBe(400);
+  });
+
+  it('refuses customers', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    expect((await discount(order.id, 10, token)).status).toBe(403);
+  });
+});
