diff --git a/test/orders-quantity-cap.test.ts b/test/orders-quantity-cap.test.ts
new file mode 100644
index 0000000..e36a305
--- /dev/null
+++ b/test/orders-quantity-cap.test.ts
@@ -0,0 +1,18 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order quantity cap', () => {
+  it('accepts 100 and refuses 101', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const order = (quantity: number) =>
+      POST(jsonRequest('/api/orders', { body: { productId: product.id, quantity }, token }));
+    expect((await order(100)).status).toBe(201);
+    expect((await order(101)).status).toBe(400);
+    expect(await db.order.count()).toBe(1);
+  });
+});
