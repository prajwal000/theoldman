@@ -0,0 +1,33 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('admin order list', () => {
+  it('lists the newest orders with their customer', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: customer } = await createUser();
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200 },
+    });
+    await db.order.create({
+      data: {
+        userId: customer.id,
+        productId: product.id,
+        quantity: 1,
+        totalCents: 1200,
+      },
+    });
+    const response = await GET(jsonRequest('/api/admin/orders', { token }));
+    expect(response.status).toBe(200);
+    const orders = (await response.json()) as { user: { email: string } }[];
+    expect(orders.map((order) => order.user.email)).toEqual([customer.email]);
+  });
+
+  it('refuses anonymous requests', async () => {
+    const response = await GET(jsonRequest('/api/admin/orders'));
+    expect(response.status).toBe(401);
+  });
+});
