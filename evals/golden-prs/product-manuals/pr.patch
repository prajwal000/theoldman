+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { jsonError } from '../../../lib/http';
+
+/** Product manuals are PDFs kept in `manuals/` next to the app. */
+const MANUALS_DIR = join(process.cwd(), 'manuals');
+
+export async function GET(request: Request): Promise<Response> {
+  const file = new URL(request.url).searchParams.get('file');
+  if (file === null || !file.endsWith('.pdf')) return jsonError(400, 'file must name a PDF');
+
+  let pdf: Buffer;
+  try {
+    pdf = await readFile(join(MANUALS_DIR, file));
+  } catch {
+    return jsonError(404, 'manual not found');
+  }
+  return new Response(new Uint8Array(pdf), {
+    headers: {
+      'content-type': 'application/pdf',
+      'content-disposition': 'inline',
+    },
+  });
+}
diff --git a/test/manuals.test.ts b/test/manuals.test.ts
new file mode 100644
