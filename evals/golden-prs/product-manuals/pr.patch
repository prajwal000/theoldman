+++ b/test/manuals.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/manuals/route';
+import { jsonRequest } from './helpers';
+
+function manual(file: string) {
+  return GET(jsonRequest(`/api/manuals?file=${encodeURIComponent(file)}`));
+}
+
+describe('product manuals', () => {
+  it('serves a manual as a PDF', async () => {
+    const response = await manual('mug.pdf');
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toBe('application/pdf');
+    expect((await response.text()).startsWith('%PDF-')).toBe(true);
+  });
+
+  it('answers 404 for a manual that does not exist', async () => {
+    expect((await manual('kettle.pdf')).status).toBe(404);
+  });
+
+  it('refuses a file that is not a PDF', async () => {
+    expect((await manual('mug.txt')).status).toBe(400);
+  });
+});
