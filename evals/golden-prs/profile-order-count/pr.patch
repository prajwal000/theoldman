diff --git a/test/users-me-orders.test.ts b/test/users-me-orders.test.ts
new file mode 100644
index 0000000..4ae99a5
--- /dev/null
+++ b/test/users-me-orders.test.ts
@@ -0,0 +1,28 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET as me } from '../src/app/api/users/me/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order count on the profile', () => {
+  it("counts the signed-in user's orders only", async () => {
+    const { user, token } = await createUser();
+    const { user: other } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    for (const userId of [user.id, user.id, other.id]) {
+      await db.order.create({
+        data: { userId, productId: product.id, quantity: 1, totalCents: 1200 },
+      });
+    }
+    const response = await me(jsonRequest('/api/users/me', { token }));
+    expect(await response.json()).toMatchObject({ user: { id: user.id }, orderCount: 2 });
+  });
+
+  it('gives 0 before the first order', async () => {
+    const { token } = await createUser();
+    expect(await (await me(jsonRequest('/api/users/me', { token }))).json()).toMatchObject({
+      orderCount: 0,
+    });
+  });
+});
