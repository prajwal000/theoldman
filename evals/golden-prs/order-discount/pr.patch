diff --git a/test/orders-discount.test.ts b/test/orders-discount.test.ts
new file mode 100644
index 0000000..9145585
--- /dev/null
+++ b/test/orders-discount.test.ts
@@ -0,0 +1,35 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function order(quantity: number): Promise<{ totalCents: number }> {
+  const { token } = await createUser();
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1000 } });
+  const response = await POST(
+    jsonRequest('/api/orders', { body: { productId: product.id, quantity }, token }),
+  );
+  expect(response.status).toBe(201);
+  return (await response.json()) as { totalCents: number };
+}
+
+describe('bulk discount', () => {
+  it('takes 10% off a large order', async () => {
+    expect((await order(20)).totalCents).toBe(18000);
+  });
+
+  it('rounds the discounted total to the cent', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Pen', priceCents: 199 } });
+    const response = await POST(
+      jsonRequest('/api/orders', { body: { productId: product.id, quantity: 15 }, token }),
+    );
+    expect(await response.json()).toMatchObject({ totalCents: 2687 });
+  });
+
+  it('charges full price for a small order', async () => {
+    expect((await order(2)).totalCents).toBe(2000);
+  });
+});
