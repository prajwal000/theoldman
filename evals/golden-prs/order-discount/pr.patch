+const BULK_QUANTITY = 10;
+const BULK_DISCOUNT_PERCENT = 10;
+
+function orderTotal(priceCents: number, quantity: number): number {
+  const subtotal = priceCents * quantity;
+  if (quantity > BULK_QUANTITY) {
+    return Math.round((subtotal * (100 - BULK_DISCOUNT_PERCENT)) / 100);
+  }
+  return subtotal;
+}
