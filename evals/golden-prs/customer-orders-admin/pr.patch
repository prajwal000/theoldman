--- /dev/null
+++ b/test/admin-customer-orders.test.ts
@@ -0,0 +1,41 @@
+import { beforeAll, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/users/[id]/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeAll(resetDatabase);
+
+let adminToken = '';
+let customer = { id: '', token: '' };
+
+function customerOrders(id: string, token: string) {
+  return GET(jsonRequest(`/api/admin/users/${id}/orders`, { token }), params({ id }));
+}
+
+describe("a customer's orders, for admins", () => {
+  it('lists nothing before the first order', async () => {
+    adminToken = (await createUser('ADMIN')).token;
+    const { user, token } = await createUser();
+    customer = { id: user.id, token };
+    const response = await customerOrders(customer.id, adminToken);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual([]);
+  });
+
+  it("lists the customer's orders once they order", async () => {
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await db.order.create({
+      data: { userId: customer.id, productId: product.id, quantity: 1, totalCents: 1200 },
+    });
+    const response = await customerOrders(customer.id, adminToken);
+    expect(await response.json()).toMatchObject([{ product: { name: 'Mug' }, totalCents: 1200 }]);
+  });
+
+  it('refuses customers', async () => {
+    expect((await customerOrders(customer.id, customer.token)).status).toBe(403);
+  });
+
+  it('answers 404 for an unknown customer', async () => {
+    expect((await customerOrders('missing', adminToken)).status).toBe(404);
+  });
+});
