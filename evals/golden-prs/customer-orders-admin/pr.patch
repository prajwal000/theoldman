@@ -0,0 +1,22 @@
+import { getCurrentUser } from '../../../../../../lib/auth';
+import { db } from '../../../../../../lib/db';
+import { jsonError } from '../../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+export async function GET(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, "only admins can see a customer's orders");
+
+  const { id } = await params;
+  if ((await db.user.count({ where: { id } })) === 0) return jsonError(404, 'customer not found');
+  const orders = await db.order.findMany({
+    where: { userId: id },
+    include: { product: { select: { id: true, name: true } } },
+    orderBy: { createdAt: 'desc' },
+  });
+  return Response.json(orders);
+}
diff --git a/test/admin-customer-orders.test.ts b/test/admin-customer-orders.test.ts
new file mode 100644
