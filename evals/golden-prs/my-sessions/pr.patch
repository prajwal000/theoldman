@@ -0,0 +1,30 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/users/me/sessions/route';
+import { createSession } from '../src/lib/auth';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('your sessions', () => {
+  it('lists your current sessions without their token hashes', async () => {
+    const { user, token } = await createUser();
+    await createSession(user.id);
+    await createUser();
+    const expired = await db.session.create({
+      data: { userId: user.id, tokenHash: 'old', expiresAt: new Date(Date.now() - 1000) },
+    });
+
+    const response = await GET(jsonRequest('/api/users/me/sessions', { token }));
+    const sessions = (await response.json()) as Record<string, unknown>[];
+    expect(sessions).toHaveLength(2);
+    expect(sessions.map((session) => session.id)).not.toContain(expired.id);
+    for (const session of sessions) {
+      expect(Object.keys(session).sort()).toEqual(['createdAt', 'expiresAt', 'id']);
+    }
+  });
+
+  it('refuses anonymous requests', async () => {
+    expect((await GET(jsonRequest('/api/users/me/sessions'))).status).toBe(401);
+  });
+});
