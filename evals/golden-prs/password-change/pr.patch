+++ b/src/app/api/users/me/password/route.ts
@@ -0,0 +1,35 @@
+import {
+  createSession,
+  getCurrentUser,
+  hashPassword,
+  MIN_PASSWORD_LENGTH,
+  verifyPassword,
+} from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../../lib/http';
+
+export async function POST(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const body = await readJson(request);
+  if (!isRecord(body) || typeof body.newPassword !== 'string') {
+    return jsonError(400, 'newPassword is required');
+  }
+  if (body.newPassword.length < MIN_PASSWORD_LENGTH) {
+    return jsonError(400, `password must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+  if (
+    typeof body.currentPassword === 'string' &&
+    !(await verifyPassword(body.currentPassword, user.passwordHash))
+  ) {
+    return jsonError(403, 'current password is wrong');
+  }
+
+  const passwordHash = await hashPassword(body.newPassword);
+  await db.$transaction([
+    db.user.update({ where: { id: user.id }, data: { passwordHash } }),
+    db.session.deleteMany({ where: { userId: user.id } }),
+  ]);
+  return Response.json({ token: await createSession(user.id) });
+}
diff --git a/test/password-change.test.ts b/test/password-change.test.ts
new file mode 100644
index 0000000..f48598b
--- /dev/null
+++ b/test/password-change.test.ts
@@ -0,0 +1,54 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as login } from '../src/app/api/auth/login/route';
+import { POST as changePassword } from '../src/app/api/users/me/password/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+const CURRENT = 'correct horse battery';
+
+function change(body: unknown, token: string) {
+  return changePassword(jsonRequest('/api/users/me/password', { body, token }));
+}
+
+describe('changing the password', () => {
+  it('changes the password and signs out every other session', async () => {
+    const { user, token } = await createUser();
+    const response = await change(
+      { currentPassword: CURRENT, newPassword: 'a new passphrase' },
+      token,
+    );
+    expect(response.status).toBe(200);
+    const { token: fresh } = (await response.json()) as { token: string };
+
+    expect((await me(jsonRequest('/api/users/me', { token }))).status).toBe(401);
+    expect((await me(jsonRequest('/api/users/me', { token: fresh }))).status).toBe(200);
+    const signIn = await login(
+      jsonRequest('/api/auth/login', { body: { email: user.email, password: 'a new passphrase' } }),
+    );
+    expect(signIn.status).toBe(200);
+  });
+
+  it('refuses a wrong current password', async () => {
+    const { token } = await createUser();
+    const response = await change(
+      { currentPassword: 'not it', newPassword: 'a new passphrase' },
+      token,
+    );
+    expect(response.status).toBe(403);
+  });
+
+  it('refuses a short new password', async () => {
+    const { token } = await createUser();
+    const response = await change({ currentPassword: CURRENT, newPassword: 'short' }, token);
+    expect(response.status).toBe(400);
+  });
+
+  it('refuses anonymous requests', async () => {
+    const response = await changePassword(
+      jsonRequest('/api/users/me/password', { body: { newPassword: 'a new passphrase' } }),
+    );
+    expect(response.status).toBe(401);
+  });
+});
