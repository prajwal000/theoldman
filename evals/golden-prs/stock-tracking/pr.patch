diff --git a/test/orders-stock.test.ts b/test/orders-stock.test.ts
new file mode 100644
index 0000000..7128a9e
--- /dev/null
+++ b/test/orders-stock.test.ts
@@ -0,0 +1,51 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST } from '../src/app/api/orders/route';
+import { POST as addProduct } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function order(productId: string, quantity: number, token: string) {
+  return POST(jsonRequest('/api/orders', { body: { productId, quantity }, token }));
+}
+
+describe('stock', () => {
+  it('lets an admin set the stock of a new product', async () => {
+    const { token } = await createUser('ADMIN');
+    const response = await addProduct(
+      jsonRequest('/api/products', { body: { name: 'Mug', priceCents: 1200, stock: 5 }, token }),
+    );
+    expect(response.status).toBe(201);
+    expect(await response.json()).toMatchObject({ stock: 5 });
+    const bad = await addProduct(
+      jsonRequest('/api/products', { body: { name: 'Mug', priceCents: 1200, stock: -1 }, token }),
+    );
+    expect(bad.status).toBe(400);
+  });
+
+  it('takes ordered items out of stock', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200, stock: 5 } });
+    expect((await order(product.id, 2, token)).status).toBe(201);
+    const stored = await db.product.findUniqueOrThrow({ where: { id: product.id } });
+    expect(stored.stock).toBe(3);
+  });
+
+  it('refuses an order larger than the stock, and keeps the stock', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200, stock: 1 } });
+    expect((await order(product.id, 2, token)).status).toBe(409);
+    const stored = await db.product.findUniqueOrThrow({ where: { id: product.id } });
+    expect(stored.stock).toBe(1);
+    expect(await db.order.count()).toBe(0);
+  });
+
+  it('does not track products without a stock count', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'E-book', priceCents: 500 } });
+    expect((await order(product.id, 100, token)).status).toBe(201);
+    const stored = await db.product.findUniqueOrThrow({ where: { id: product.id } });
+    expect(stored.stock).toBeNull();
+  });
+});
