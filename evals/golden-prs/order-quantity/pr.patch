+import { getCurrentUser } from '../../../../lib/auth';
+import { db } from '../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+export async function PATCH(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const body = await readJson(request);
+  if (
+    !isRecord(body) ||
+    typeof body.quantity !== 'number' ||
+    !Number.isInteger(body.quantity) ||
+    body.quantity < 1
+  ) {
+    return jsonError(400, 'a whole, positive quantity is required');
+  }
+  const { id } = await params;
+  const order = await db.order.findFirst({ where: { id, userId: user.id } });
+  if (order === null) return jsonError(404, 'order not found');
+
+  const totalCents = order.totalCents * body.quantity;
+  const { count } = await db.order.updateMany({
+    where: { id, status: 'PENDING' },
+    data: { quantity: body.quantity, totalCents },
+  });
+  if (count === 0) return jsonError(409, 'only pending orders can be changed');
+  return Response.json({ ...order, quantity: body.quantity, totalCents });
+}
