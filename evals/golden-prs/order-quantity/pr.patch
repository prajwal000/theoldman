+++ b/test/orders-quantity.test.ts
@@ -0,0 +1,58 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PATCH } from '../src/app/api/orders/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string, status: 'PENDING' | 'PAID' = 'PENDING') {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 1, totalCents: 1200, status },
+  });
+}
+
+function patch(id: string, body: unknown, token: string) {
+  return PATCH(jsonRequest(`/api/orders/${id}`, { method: 'PATCH', body, token }), params({ id }));
+}
+
+describe('changing an order quantity', () => {
+  it('changes the quantity and the total of a pending order', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    const response = await patch(order.id, { quantity: 3 }, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ quantity: 3, totalCents: 3600 });
+    const stored = await db.order.findUniqueOrThrow({ where: { id: order.id } });
+    expect(stored).toMatchObject({ quantity: 3, totalCents: 3600 });
+  });
+
+  it('keeps the price the order was placed at', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    await db.product.update({ where: { id: order.productId }, data: { priceCents: 9900 } });
+    const response = await patch(order.id, { quantity: 2 }, token);
+    expect(await response.json()).toMatchObject({ totalCents: 2400 });
+  });
+
+  it('refuses a paid order', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id, 'PAID');
+    expect((await patch(order.id, { quantity: 2 }, token)).status).toBe(409);
+  });
+
+  it("does not find another customer's order", async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const order = await orderFor(other.id);
+    expect((await patch(order.id, { quantity: 2 }, token)).status).toBe(404);
+  });
+
+  it('refuses a quantity that is not a whole, positive number', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    for (const quantity of [0, -1, 1.5, '2', null]) {
+      expect((await patch(order.id, { quantity }, token)).status).toBe(400);
+    }
+  });
+});
