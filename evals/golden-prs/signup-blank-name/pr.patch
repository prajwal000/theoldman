diff --git a/test/signup-blank-name.test.ts b/test/signup-blank-name.test.ts
new file mode 100644
index 0000000..37f9231
--- /dev/null
+++ b/test/signup-blank-name.test.ts
@@ -0,0 +1,20 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as signup } from '../src/app/api/auth/signup/route';
+import { db } from '../src/lib/db';
+import { jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('signup name', () => {
+  it('refuses a name of only spaces and creates no account', async () => {
+    const body = { email: 'ada@example.com', name: '   ', password: 'analytical engine' };
+    expect((await signup(jsonRequest('/api/auth/signup', { body }))).status).toBe(400);
+    expect(await db.user.count()).toBe(0);
+  });
+
+  it('stores the trimmed name', async () => {
+    const body = { email: 'ada@example.com', name: '  Ada ', password: 'analytical engine' };
+    expect((await signup(jsonRequest('/api/auth/signup', { body }))).status).toBe(201);
+    expect((await db.user.findFirstOrThrow()).name).toBe('Ada');
+  });
+});
