+/** The signed-in admin, or the 401 or 403 response to send instead; `action` ends the 403 message. */
+export async function requireAdmin(request: Request, action: string): Promise<User | Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, `only admins can ${action}`);
+  return user;
+}
