diff --git a/test/products-admin.test.ts b/test/products-admin.test.ts
new file mode 100644
index 0000000..f970e11
--- /dev/null
+++ b/test/products-admin.test.ts
@@ -0,0 +1,32 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { DELETE } from '../src/app/api/products/[id]/route';
+import { POST } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function remove(id: string, token?: string) {
+  return DELETE(jsonRequest(`/api/products/${id}`, { method: 'DELETE', token }), params({ id }));
+}
+
+describe('admin checks on product routes', () => {
+  it('refuses to delete for customers and anonymous requests, keeping the product', async () => {
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    const { token } = await createUser();
+    const customer = await remove(product.id, token);
+    expect(customer.status).toBe(403);
+    expect(await customer.json()).toEqual({ error: 'only admins can delete products' });
+    expect((await remove(product.id)).status).toBe(401);
+    expect(await db.product.count()).toBe(1);
+  });
+
+  it('keeps the messages for adding a product', async () => {
+    const { token } = await createUser();
+    const body = { name: 'Mug', priceCents: 1200 };
+    const customer = await POST(jsonRequest('/api/products', { body, token }));
+    expect(await customer.json()).toEqual({ error: 'only admins can add products' });
+    const anonymous = await POST(jsonRequest('/api/products', { body }));
+    expect(await anonymous.json()).toEqual({ error: 'sign in first' });
+  });
+});
