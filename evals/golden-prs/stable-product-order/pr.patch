diff --git a/test/products-order.test.ts b/test/products-order.test.ts
new file mode 100644
index 0000000..e789140
--- /dev/null
+++ b/test/products-order.test.ts
@@ -0,0 +1,20 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('product list order', () => {
+  it('breaks ties in createdAt by id, newest id first', async () => {
+    const createdAt = new Date(1000);
+    for (const id of ['b', 'c', 'a']) {
+      await db.product.create({ data: { id, name: id, priceCents: 1, createdAt } });
+    }
+    await db.product.create({
+      data: { id: 'z', name: 'older', priceCents: 1, createdAt: new Date(0) },
+    });
+    const products = (await (await GET()).json()) as { id: string }[];
+    expect(products.map((product) => product.id)).toEqual(['c', 'b', 'a', 'z']);
+  });
+});
