diff --git a/test/session-renewal.test.ts b/test/session-renewal.test.ts
new file mode 100644
index 0000000..2fcf8e0
--- /dev/null
+++ b/test/session-renewal.test.ts
@@ -0,0 +1,42 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { getCurrentUser, hashToken } from '../src/lib/auth';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+async function sessionExpiringIn(ms: number): Promise<{ token: string; id: string }> {
+  const { token } = await createUser();
+  const session = await db.session.update({
+    where: { tokenHash: hashToken(token) },
+    data: { expiresAt: new Date(Date.now() + ms) },
+  });
+  return { token, id: session.id };
+}
+
+async function expiresAt(id: string): Promise<number> {
+  const session = await db.session.findUniqueOrThrow({ where: { id } });
+  return session.expiresAt.getTime();
+}
+
+describe('session renewal', () => {
+  it('extends a session used in its last week to 30 days', async () => {
+    const { token, id } = await sessionExpiringIn(60 * 60 * 1000);
+    expect(await getCurrentUser(jsonRequest('/api/users/me', { token }))).not.toBeNull();
+    expect(await expiresAt(id)).toBeGreaterThan(Date.now() + 29 * DAY_MS);
+  });
+
+  it('leaves a session with weeks left alone', async () => {
+    const { token, id } = await sessionExpiringIn(20 * DAY_MS);
+    const before = await expiresAt(id);
+    await getCurrentUser(jsonRequest('/api/users/me', { token }));
+    expect(await expiresAt(id)).toBe(before);
+  });
+
+  it('does not bring back an expired session', async () => {
+    const { token } = await sessionExpiringIn(-1000);
+    expect(await getCurrentUser(jsonRequest('/api/users/me', { token }))).toBeNull();
+  });
+});
