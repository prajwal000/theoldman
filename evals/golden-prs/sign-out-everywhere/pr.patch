+/**
+ * Signs the user out on their other devices. The session that made the request stays signed
+ * in, so the user can carry on. Returns how many sessions were ended.
+ */
+export async function endAllSessions(userId: string): Promise<number> {
+  const { count } = await db.session.deleteMany({ where: { userId } });
+  return count;
+}
