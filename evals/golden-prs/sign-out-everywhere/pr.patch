diff --git a/test/logout-all.test.ts b/test/logout-all.test.ts
new file mode 100644
index 0000000..e6e71d3
--- /dev/null
+++ b/test/logout-all.test.ts
@@ -0,0 +1,33 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as logoutAll } from '../src/app/api/auth/logout-all/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { createSession } from '../src/lib/auth';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('signing out everywhere', () => {
+  it('ends every session of the user, this one included', async () => {
+    const { user, token } = await createUser();
+    const phone = await createSession(user.id);
+    const response = await logoutAll(
+      jsonRequest('/api/auth/logout-all', { method: 'POST', token }),
+    );
+    expect(await response.json()).toEqual({ ended: 2 });
+    for (const session of [token, phone]) {
+      expect((await me(jsonRequest('/api/users/me', { token: session }))).status).toBe(401);
+    }
+  });
+
+  it("leaves other users' sessions alone", async () => {
+    const { token } = await createUser();
+    const { token: other } = await createUser();
+    await logoutAll(jsonRequest('/api/auth/logout-all', { method: 'POST', token }));
+    expect((await me(jsonRequest('/api/users/me', { token: other }))).status).toBe(200);
+  });
+
+  it('refuses anonymous requests', async () => {
+    const response = await logoutAll(jsonRequest('/api/auth/logout-all', { method: 'POST' }));
+    expect(response.status).toBe(401);
+  });
+});
