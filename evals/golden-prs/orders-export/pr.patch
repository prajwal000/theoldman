+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+const HEADER = ['order', 'customer', 'email', 'product', 'quantity', 'total', 'status', 'placed'];
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can export orders');
+
+  const orders = await db.order.findMany({
+    include: {
+      user: { select: { name: true, email: true } },
+      product: { select: { name: true } },
+    },
+    orderBy: { createdAt: 'asc' },
+  });
+  const rows = orders.map((order) =>
+    [
+      order.id,
+      order.user.name,
+      order.user.email,
+      order.product.name,
+      order.quantity,
+      (order.totalCents / 100).toFixed(2),
+      order.status,
+      order.createdAt.toISOString(),
+    ].join(','),
+  );
+  return new Response([HEADER.join(','), ...rows].join('\r\n') + '\r\n', {
+    headers: {
+      'content-type': 'text/csv; charset=utf-8',
+      'content-disposition': 'attachment; filename="orders.csv"',
+    },
+  });
+}
diff --git a/test/admin-orders-export.test.ts b/test/admin-orders-export.test.ts
