@@ -0,0 +1,34 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/admin/orders/export/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('order export', () => {
+  it('exports every order as CSV', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: customer } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1250 } });
+    const order = await db.order.create({
+      data: {
+        userId: customer.id,
+        productId: product.id,
+        quantity: 2,
+        totalCents: 2500,
+        createdAt: new Date('2026-11-02T10:00:00Z'),
+      },
+    });
+    const response = await GET(jsonRequest('/api/admin/orders/export', { token }));
+    expect(response.headers.get('content-type')).toBe('text/csv; charset=utf-8');
+    expect(await response.text()).toBe(
+      'order,customer,email,product,quantity,total,status,placed\r\n' +
+        `${order.id},Test User,${customer.email},Mug,2,25.00,PENDING,2026-11-02T10:00:00.000Z\r\n`,
+    );
+  });
+
+  it('refuses customers', async () => {
+    const { token } = await createUser();
+    expect((await GET(jsonRequest('/api/admin/orders/export', { token }))).status).toBe(403);
+  });
+});
