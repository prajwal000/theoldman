--- /dev/null
+++ b/test/products-order-count.test.ts
@@ -0,0 +1,28 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { createUser, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('product order counts', () => {
+  it('counts the pending and paid orders of each product', async () => {
+    const { user } = await createUser();
+    const mug = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200, createdAt: new Date(2000) },
+    });
+    await db.product.create({
+      data: { name: 'Plate', priceCents: 900, createdAt: new Date(1000) },
+    });
+    for (const status of ['PENDING', 'PAID', 'CANCELLED'] as const) {
+      await db.order.create({
+        data: { userId: user.id, productId: mug.id, quantity: 1, totalCents: 1200, status },
+      });
+    }
+    const products = (await (await GET()).json()) as { name: string; orderCount: number }[];
+    expect(products.map(({ name, orderCount }) => ({ name, orderCount }))).toEqual([
+      { name: 'Mug', orderCount: 2 },
+      { name: 'Plate', orderCount: 0 },
+    ]);
+  });
+});
