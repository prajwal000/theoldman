@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string) {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 2, totalCents: 2400 },
+  });
+}
+
+function receipt(id: string, token?: string) {
+  return GET(jsonRequest(`/api/orders/${id}`, { token }), params({ id }));
+}
+
+describe('order receipt', () => {
+  it('shows the order with its product and customer', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    const response = await receipt(order.id, token);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      id: order.id,
+      totalCents: 2400,
+      product: { name: 'Mug', priceCents: 1200 },
+      user: { email: user.email, name: user.name },
+    });
+  });
+
+  it("does not show another customer's order", async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const order = await orderFor(other.id);
+    expect((await receipt(order.id, token)).status).toBe(404);
+  });
+
+  it('refuses anonymous requests', async () => {
+    expect((await receipt('any')).status).toBe(401);
+  });
+});
