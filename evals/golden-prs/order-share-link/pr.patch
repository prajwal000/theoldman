+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+function shareCode(): string {
+  return Math.random().toString(36).slice(2, 10);
+}
+
+export async function POST(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const { id } = await params;
+  const order = await db.order.findFirst({ where: { id, userId: user.id } });
+  if (order === null) return jsonError(404, 'order not found');
+
+  // Only the first share sets the token, so links already handed out keep working.
+  await db.order.updateMany({ where: { id, shareToken: null }, data: { shareToken: shareCode() } });
+  const { shareToken } = await db.order.findUniqueOrThrow({
+    where: { id },
+    select: { shareToken: true },
+  });
+  return Response.json({ url: `/api/shared/${shareToken ?? ''}` });
+}
