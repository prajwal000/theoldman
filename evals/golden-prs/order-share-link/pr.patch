+++ b/src/app/api/shared/[token]/route.ts
@@ -0,0 +1,22 @@
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ token: string }>;
+}
+
+/** A shared order shows what was bought, never who bought it. */
+export async function GET(_request: Request, { params }: Context): Promise<Response> {
+  const { token } = await params;
+  const order = await db.order.findUnique({
+    where: { shareToken: token },
+    select: {
+      quantity: true,
+      totalCents: true,
+      createdAt: true,
+      product: { select: { name: true } },
+    },
+  });
+  if (order === null) return jsonError(404, 'shared order not found');
+  return Response.json(order);
+}
diff --git a/test/orders-share.test.ts b/test/orders-share.test.ts
new file mode 100644
index 0000000..08957fe
--- /dev/null
+++ b/test/orders-share.test.ts
@@ -0,0 +1,52 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as share } from '../src/app/api/orders/[id]/share/route';
+import { GET as shared } from '../src/app/api/shared/[token]/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string) {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 2, totalCents: 2400 },
+  });
+}
+
+async function shareLink(id: string, token: string): Promise<Response> {
+  return share(jsonRequest(`/api/orders/${id}/share`, { method: 'POST', token }), params({ id }));
+}
+
+function view(url: string) {
+  const token = url.split('/').at(-1) ?? '';
+  return shared(jsonRequest(url), params({ token }));
+}
+
+describe('sharing an order', () => {
+  it('gives a link that shows what was bought but not who bought it', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    const { url } = (await (await shareLink(order.id, token)).json()) as { url: string };
+    const body = (await (await view(url)).json()) as Record<string, unknown>;
+    expect(body).toMatchObject({ quantity: 2, totalCents: 2400, product: { name: 'Mug' } });
+    expect(body).not.toHaveProperty('userId');
+  });
+
+  it('keeps the same link when shared again', async () => {
+    const { user, token } = await createUser();
+    const order = await orderFor(user.id);
+    const first = await (await shareLink(order.id, token)).json();
+    expect(await (await shareLink(order.id, token)).json()).toEqual(first);
+  });
+
+  it("does not share another customer's order", async () => {
+    const { token } = await createUser();
+    const { user: other } = await createUser();
+    const order = await orderFor(other.id);
+    expect((await shareLink(order.id, token)).status).toBe(404);
+  });
+
+  it('answers 404 for an unknown link', async () => {
+    expect((await view('/api/shared/nope')).status).toBe(404);
+  });
+});
