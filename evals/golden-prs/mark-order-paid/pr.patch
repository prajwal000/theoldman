+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+export async function POST(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can mark orders paid');
+
+  const { id } = await params;
+  const { count } = await db.order.updateMany({
+    where: { id, status: 'PENDING' },
+    data: { status: 'PAID' },
+  });
+  if (count === 0) {
+    const exists = (await db.order.count({ where: { id } })) > 0;
+    return exists
+      ? jsonError(409, 'only pending orders can be marked paid')
+      : jsonError(404, 'order not found');
+  }
+  return Response.json({ id, status: 'PAID' });
+}
diff --git a/test/orders-pay.test.ts b/test/orders-pay.test.ts
new file mode 100644
