@@ -0,0 +1,50 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as pay } from '../src/app/api/orders/[id]/pay/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function orderFor(userId: string, status: 'PENDING' | 'PAID' = 'PENDING') {
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  return db.order.create({
+    data: { userId, productId: product.id, quantity: 1, totalCents: 1200, status },
+  });
+}
+
+function markPaid(id: string, token?: string) {
+  return pay(jsonRequest(`/api/orders/${id}/pay`, { method: 'POST', token }), params({ id }));
+}
+
+describe('marking an order paid', () => {
+  it('lets an admin mark a pending order paid', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: customer } = await createUser();
+    const order = await orderFor(customer.id);
+    const response = await markPaid(order.id, token);
+    expect(response.status).toBe(200);
+    const stored = await db.order.findUniqueOrThrow({ where: { id: order.id } });
+    expect(stored.status).toBe('PAID');
+  });
+
+  it('refuses customers', async () => {
+    const { user } = await createUser();
+    const order = await orderFor(user.id);
+    const response = await markPaid(order.id);
+    expect(response.status).not.toBe(200);
+    const stored = await db.order.findUniqueOrThrow({ where: { id: order.id } });
+    expect(stored.status).toBe('PENDING');
+  });
+
+  it('refuses an order that is not pending', async () => {
+    const { token } = await createUser('ADMIN');
+    const { user: customer } = await createUser();
+    const order = await orderFor(customer.id, 'PAID');
+    expect((await markPaid(order.id, token)).status).toBe(409);
+  });
+
+  it('answers 404 for an unknown order', async () => {
+    const { token } = await createUser('ADMIN');
+    expect((await markPaid('missing', token)).status).toBe(404);
+  });
+});
