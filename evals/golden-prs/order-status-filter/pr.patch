diff --git a/test/orders-filter.test.ts b/test/orders-filter.test.ts
new file mode 100644
index 0000000..931028b
--- /dev/null
+++ b/test/orders-filter.test.ts
@@ -0,0 +1,35 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function seed() {
+  const { user, token } = await createUser();
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  for (const status of ['PENDING', 'PAID'] as const) {
+    await db.order.create({
+      data: { userId: user.id, productId: product.id, quantity: 1, totalCents: 1200, status },
+    });
+  }
+  return token;
+}
+
+async function statuses(url: string, token: string): Promise<string[]> {
+  const orders = (await (await GET(jsonRequest(url, { token }))).json()) as { status: string }[];
+  return orders.map((order) => order.status).sort();
+}
+
+describe('filtering orders by status', () => {
+  it('lists only the orders with the status asked for', async () => {
+    const token = await seed();
+    expect(await statuses('/api/orders?status=PENDING', token)).toEqual(['PENDING']);
+    expect(await statuses('/api/orders', token)).toEqual(['PAID', 'PENDING']);
+  });
+
+  it('refuses an unknown status', async () => {
+    const token = await seed();
+    expect((await GET(jsonRequest('/api/orders?status=LOST', { token }))).status).toBe(400);
+  });
+});
