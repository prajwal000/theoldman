+/// What admins did, for accountability. Append-only: no route edits or deletes entries. Ids are
+/// plain strings, not relations, so entries outlive the users and products they name.
+model AuditLog {
+  id        String   @id @default(cuid())
+  actorId   String
+  action    String
+  targetId  String
+  createdAt DateTime @default(now())
+
+  @@index([createdAt])
+}
