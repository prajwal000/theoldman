diff --git a/src/lib/audit.ts b/src/lib/audit.ts
new file mode 100644
index 0000000..8350f88
--- /dev/null
+++ b/src/lib/audit.ts
@@ -0,0 +1,16 @@
+import type { Prisma } from '../generated/prisma/client';
+
+export type AuditAction = 'product.create' | 'product.delete';
+
+/**
+ * Records an admin action. Pass the transaction that performs the action, so an entry exists
+ * exactly when the action happened.
+ */
+export async function audit(
+  tx: Prisma.TransactionClient,
+  actorId: string,
+  action: AuditAction,
+  targetId: string,
+): Promise<void> {
+  await tx.auditLog.create({ data: { actorId, action, targetId } });
+}
diff --git a/test/audit-log.test.ts b/test/audit-log.test.ts
new file mode 100644
index 0000000..831f573
--- /dev/null
+++ b/test/audit-log.test.ts
@@ -0,0 +1,51 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET as auditLog } from '../src/app/api/admin/audit-log/route';
+import { DELETE } from '../src/app/api/products/[id]/route';
+import { POST } from '../src/app/api/products/route';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+interface Entry {
+  actorId: string;
+  action: string;
+  targetId: string;
+}
+
+async function entries(token: string): Promise<Entry[]> {
+  const response = await auditLog(jsonRequest('/api/admin/audit-log', { token }));
+  return ((await response.json()) as { entries: Entry[] }).entries;
+}
+
+describe('audit log', () => {
+  it('records product creation and deletion, newest first', async () => {
+    const { user, token } = await createUser('ADMIN');
+    const created = await POST(
+      jsonRequest('/api/products', { body: { name: 'Mug', priceCents: 1 }, token }),
+    );
+    const { id } = (await created.json()) as { id: string };
+    await DELETE(jsonRequest(`/api/products/${id}`, { method: 'DELETE', token }), params({ id }));
+
+    expect(await entries(token)).toMatchObject([
+      { actorId: user.id, action: 'product.delete', targetId: id },
+      { actorId: user.id, action: 'product.create', targetId: id },
+    ]);
+  });
+
+  it('records nothing for actions that did not happen', async () => {
+    const admin = await createUser('ADMIN');
+    const customer = await createUser();
+    await DELETE(
+      jsonRequest('/api/products/missing', { method: 'DELETE', token: admin.token }),
+      params({ id: 'missing' }),
+    );
+    await POST(
+      jsonRequest('/api/products', { body: { name: 'Mug', priceCents: 1 }, token: customer.token }),
+    );
+    expect(await entries(admin.token)).toEqual([]);
+    const forbidden = await auditLog(
+      jsonRequest('/api/admin/audit-log', { token: customer.token }),
+    );
+    expect(forbidden.status).toBe(403);
+  });
+});
