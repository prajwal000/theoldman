+export async function PATCH(request: Request, { params }: Context): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'only admins can edit products');
+
+  const ifMatch = request.headers.get('if-match');
+  if (ifMatch === null) return jsonError(428, 'send If-Match with the ETag you last read');
+
+  const body = await readJson(request);
+  if (!isRecord(body)) return jsonError(400, 'send a JSON object');
+  const changes: { name?: string; priceCents?: number } = {};
+  if (body.name !== undefined) {
+    if (typeof body.name !== 'string' || body.name.trim() === '') {
+      return jsonError(400, 'name must not be empty');
+    }
+    changes.name = body.name.trim();
+  }
+  if (body.priceCents !== undefined) {
+    if (
+      typeof body.priceCents !== 'number' ||
+      !Number.isInteger(body.priceCents) ||
+      body.priceCents < 0
+    ) {
+      return jsonError(400, 'priceCents must be a whole, non-negative number');
+    }
+    changes.priceCents = body.priceCents;
+  }
+  if (Object.keys(changes).length === 0) return jsonError(400, 'send name and/or priceCents');
+
+  const { id } = await params;
+  const version = versionFromIfMatch(ifMatch);
+  // The version check and the write are one statement, so of two edits based on the same version
+  // exactly one wins and the other gets a 412.
+  const { count } =
+    version === null
+      ? { count: 0 }
+      : await db.product.updateMany({
+          where: { id, version },
+          data: { ...changes, version: { increment: 1 } },
+        });
+  const product = await db.product.findUnique({ where: { id } });
+  if (product === null) return jsonError(404, 'product not found');
+  if (count === 0) {
+    return jsonError(412, 'the product changed since you read it; reload and try again');
+  }
+  return Response.json(product, { headers: { ETag: etagFor(product.version) } });
 }
 
