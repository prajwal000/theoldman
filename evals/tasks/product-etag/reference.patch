+++ b/test/etag.test.ts
@@ -0,0 +1,62 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET, PATCH } from '../src/app/api/products/[id]/route';
+import { db } from '../src/lib/db';
+import { createUser, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+function request(
+  id: string,
+  init: { method?: string; headers?: Record<string, string>; body?: unknown },
+) {
+  return new Request(`http://localhost/api/products/${id}`, {
+    method: init.method ?? 'GET',
+    headers: { 'content-type': 'application/json', ...init.headers },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+  });
+}
+
+describe('product ETags', () => {
+  it('answers 304 for a current ETag and changes it on every edit', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1 } });
+    const etag =
+      (await GET(request(product.id, {}), params({ id: product.id }))).headers.get('etag') ?? '';
+    const cached = await GET(
+      request(product.id, { headers: { 'if-none-match': etag } }),
+      params({ id: product.id }),
+    );
+    expect(cached.status).toBe(304);
+
+    const edited = await PATCH(
+      request(product.id, {
+        method: 'PATCH',
+        headers: { authorization: `Bearer ${token}`, 'if-match': etag },
+        body: { priceCents: 2 },
+      }),
+      params({ id: product.id }),
+    );
+    expect(edited.status).toBe(200);
+    expect(edited.headers.get('etag')).not.toBe(etag);
+  });
+
+  it('needs If-Match and refuses a stale one', async () => {
+    const { token } = await createUser('ADMIN');
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1 } });
+    const auth = { authorization: `Bearer ${token}` };
+    const missing = await PATCH(
+      request(product.id, { method: 'PATCH', headers: auth, body: { name: 'Cup' } }),
+      params({ id: product.id }),
+    );
+    expect(missing.status).toBe(428);
+    const stale = await PATCH(
+      request(product.id, {
+        method: 'PATCH',
+        headers: { ...auth, 'if-match': '"v99"' },
+        body: { name: 'Cup' },
+      }),
+      params({ id: product.id }),
+    );
+    expect(stale.status).toBe(412);
+  });
+});
