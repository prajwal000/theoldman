diff --git a/src/lib/etag.ts b/src/lib/etag.ts
new file mode 100644
index 0000000..a7d8715
--- /dev/null
+++ b/src/lib/etag.ts
@@ -0,0 +1,23 @@
+// Strong ETags from a row version, for caching (If-None-Match) and optimistic concurrency
+// (If-Match). The header lists can hold several tags and the * wildcard.
+
+export function etagFor(version: number): string {
+  return `"v${String(version)}"`;
+}
+
+/** The tags in an If-Match or If-None-Match header, with weak markers removed. */
+function tags(header: string): string[] {
+  return header.split(',').map((tag) => tag.trim().replace(/^W\//, ''));
+}
+
+export function matchesAny(header: string | null, etag: string): boolean {
+  if (header === null) return false;
+  return tags(header).some((tag) => tag === '*' || tag === etag);
+}
+
+/** The version an If-Match header names, or null if it names none we issued. */
+export function versionFromIfMatch(header: string): number | null {
+  const [tag] = tags(header);
+  const match = /^"v(\d+)"$/.exec(tag ?? '');
+  return match?.[1] === undefined ? null : Number(match[1]);
+}
diff --git a/test/etag.test.ts b/test/etag.test.ts
new file mode 100644
