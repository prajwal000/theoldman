@@ -0,0 +1,42 @@
+import { requireAdmin } from '../../../../../lib/admin';
+import { db } from '../../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../../lib/http';
+
+interface Context {
+  readonly params: Promise<{ id: string }>;
+}
+
+const ROLES = new Set(['ADMIN', 'CUSTOMER']);
+
+export async function PATCH(request: Request, { params }: Context): Promise<Response> {
+  const admin = await requireAdmin(request);
+  if (admin instanceof Response) return admin;
+
+  const body = await readJson(request);
+  if (!isRecord(body) || typeof body.role !== 'string' || !ROLES.has(body.role)) {
+    return jsonError(400, 'role must be ADMIN or CUSTOMER');
+  }
+  const role = body.role === 'ADMIN' ? 'ADMIN' : 'CUSTOMER';
+  const { id } = await params;
+
+  const result = await db.$transaction(async (tx) => {
+    // Locking every admin row first serialises role changes, so two admins demoting each other at
+    // the same moment cannot leave the shop with none.
+    const admins = await tx.$queryRaw<{ id: string }[]>`
+      SELECT id FROM "User" WHERE role = 'ADMIN' FOR UPDATE`;
+    const target = await tx.user.findUnique({ where: { id } });
+    if (target === null) return 'not-found' as const;
+    if (role === 'CUSTOMER' && target.role === 'ADMIN' && admins.length <= 1) {
+      return 'last-admin' as const;
+    }
+    return tx.user.update({
+      where: { id },
+      data: { role },
+      select: { id: true, email: true, name: true, role: true },
+    });
+  });
+
+  if (result === 'not-found') return jsonError(404, 'user not found');
+  if (result === 'last-admin') return jsonError(409, 'the shop needs at least one admin');
+  return Response.json(result);
+}
