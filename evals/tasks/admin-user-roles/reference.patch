+import type { User } from '../generated/prisma/client';
+import { getCurrentUser } from './auth';
+import { jsonError } from './http';
+
+/** The signed-in admin, or the response to send instead (401 or 403). */
+export async function requireAdmin(request: Request): Promise<User | Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+  if (user.role !== 'ADMIN') return jsonError(403, 'admins only');
+  return user;
+}
diff --git a/test/admin-users.test.ts b/test/admin-users.test.ts
new file mode 100644
