+++ b/test/admin-users.test.ts
@@ -0,0 +1,53 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { PATCH } from '../src/app/api/admin/users/[id]/route';
+import { GET as listUsers } from '../src/app/api/admin/users/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+const setRole = (token: string, id: string, role: unknown) =>
+  PATCH(
+    jsonRequest(`/api/admin/users/${id}`, { method: 'PATCH', body: { role }, token }),
+    params({ id }),
+  );
+
+describe('admin user roles', () => {
+  it('lets admins promote and demote, but never the last admin', async () => {
+    const admin = await createUser('ADMIN');
+    const customer = await createUser();
+    expect((await setRole(admin.token, customer.user.id, 'ADMIN')).status).toBe(200);
+    expect((await setRole(customer.token, admin.user.id, 'CUSTOMER')).status).toBe(200);
+    expect((await setRole(customer.token, customer.user.id, 'CUSTOMER')).status).toBe(409);
+  });
+
+  it('keeps one admin when two demote each other at once', async () => {
+    const a = await createUser('ADMIN');
+    const b = await createUser('ADMIN');
+    await Promise.all([
+      setRole(a.token, b.user.id, 'CUSTOMER'),
+      setRole(b.token, a.user.id, 'CUSTOMER'),
+    ]);
+    expect(await db.user.count({ where: { role: 'ADMIN' } })).toBe(1);
+  });
+
+  it('refuses customers, bad roles and unknown users', async () => {
+    const admin = await createUser('ADMIN');
+    const customer = await createUser();
+    expect((await setRole(customer.token, customer.user.id, 'ADMIN')).status).toBe(403);
+    expect((await setRole(admin.token, customer.user.id, 'OWNER')).status).toBe(400);
+    expect((await setRole(admin.token, 'nobody', 'ADMIN')).status).toBe(404);
+  });
+
+  it('lists users without password hashes, for admins only', async () => {
+    const admin = await createUser('ADMIN');
+    const customer = await createUser();
+    const response = await listUsers(jsonRequest('/api/admin/users', { token: admin.token }));
+    const text = await response.text();
+    expect(text).toContain(customer.user.email);
+    expect(text).not.toContain('passwordHash');
+    expect(
+      (await listUsers(jsonRequest('/api/admin/users', { token: customer.token }))).status,
+    ).toBe(403);
+  });
+});
