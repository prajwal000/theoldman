diff --git a/src/lib/uploads.ts b/src/lib/uploads.ts
new file mode 100644
index 0000000..5e2315c
--- /dev/null
+++ b/src/lib/uploads.ts
@@ -0,0 +1,22 @@
+import { join } from 'node:path';
+
+export const MAX_AVATAR_BYTES = 2 * 1024 * 1024;
+
+/** Where uploaded files are stored: UPLOAD_DIR, or `uploads` in the project root. */
+export function uploadDir(): string {
+  return process.env.UPLOAD_DIR ?? join(process.cwd(), 'uploads');
+}
+
+const PNG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+/**
+ * The image type from the file's first bytes, or null. The name and content type a client sends
+ * are not trusted: anyone can call a script `avatar.png`.
+ */
+export function imageExtension(bytes: Buffer): 'png' | 'jpg' | 'webp' | null {
+  if (bytes.subarray(0, 8).equals(PNG)) return 'png';
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'jpg';
+  const riff = bytes.subarray(0, 4).toString('latin1');
+  if (riff === 'RIFF' && bytes.subarray(8, 12).toString('latin1') === 'WEBP') return 'webp';
+  return null;
+}
diff --git a/test/avatar.test.ts b/test/avatar.test.ts
new file mode 100644
index 0000000..ea1c86b
--- /dev/null
+++ b/test/avatar.test.ts
@@ -0,0 +1,59 @@
+import { mkdtempSync, readdirSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { POST as upload } from '../src/app/api/users/me/avatar/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+const PNG = Buffer.from(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==',
+  'base64',
+);
+let dir: string;
+
+beforeAll(() => {
+  dir = mkdtempSync(join(tmpdir(), 'avatars-'));
+  process.env.UPLOAD_DIR = dir;
+});
+afterAll(() => {
+  delete process.env.UPLOAD_DIR;
+  rmSync(dir, { recursive: true, force: true });
+});
+beforeEach(resetDatabase);
+
+function uploadRequest(token: string, bytes: Buffer, name = 'me.png', type = 'image/png') {
+  const form = new FormData();
+  form.append('file', new File([new Uint8Array(bytes)], name, { type }));
+  return new Request('http://localhost/api/users/me/avatar', {
+    method: 'POST',
+    headers: { authorization: `Bearer ${token}` },
+    body: form,
+  });
+}
+
+describe('avatar upload', () => {
+  it('stores a PNG under a server-chosen name and shows it on the user', async () => {
+    const { token } = await createUser();
+    const response = await upload(uploadRequest(token, PNG, '../../evil.png'));
+    expect(response.status).toBe(200);
+    const { avatarUrl } = (await response.json()) as { avatarUrl: string };
+    expect(avatarUrl).toMatch(/^\/uploads\/[\w-]+\.png$/);
+    expect(readFileSync(join(dir, avatarUrl.slice('/uploads/'.length)))).toEqual(PNG);
+
+    const user = (await (await me(jsonRequest('/api/users/me', { token }))).json()) as {
+      user: { avatarUrl: string };
+    };
+    expect(user.user.avatarUrl).toBe(avatarUrl);
+  });
+
+  it('rejects a file that only claims to be an image, and one over 2 MB', async () => {
+    const { token } = await createUser();
+    const before = readdirSync(dir).length;
+    const fake = await upload(uploadRequest(token, Buffer.from('<?php echo 1;')));
+    expect(fake.status).toBe(400);
+    const big = Buffer.concat([PNG, Buffer.alloc(2 * 1024 * 1024)]);
+    expect((await upload(uploadRequest(token, big))).status).toBe(413);
+    expect(readdirSync(dir)).toHaveLength(before);
+  });
+});
