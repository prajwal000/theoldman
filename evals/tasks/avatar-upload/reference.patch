index 0000000..1b71d27
--- /dev/null
+++ b/src/app/api/users/me/avatar/route.ts
@@ -0,0 +1,44 @@
+import { randomUUID } from 'node:crypto';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { getCurrentUser } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { jsonError } from '../../../../../lib/http';
+import { imageExtension, MAX_AVATAR_BYTES, uploadDir } from '../../../../../lib/uploads';
+
+// Room for the multipart boundaries and headers around the file itself.
+const FORM_OVERHEAD_BYTES = 64 * 1024;
+
+export async function POST(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  // Refuse an oversized body from its declared length, before reading it into memory.
+  const declared = Number(request.headers.get('content-length') ?? 0);
+  if (declared > MAX_AVATAR_BYTES + FORM_OVERHEAD_BYTES) {
+    return jsonError(413, 'images can be at most 2 MB');
+  }
+  let form: FormData;
+  try {
+    form = await request.formData();
+  } catch {
+    return jsonError(400, 'send the image as multipart/form-data');
+  }
+  const file = form.get('file');
+  if (!(file instanceof File)) return jsonError(400, 'send the image in the "file" field');
+  if (file.size > MAX_AVATAR_BYTES) return jsonError(413, 'images can be at most 2 MB');
+
+  const bytes = Buffer.from(await file.arrayBuffer());
+  const extension = imageExtension(bytes);
+  if (extension === null) return jsonError(400, 'only PNG, JPEG and WebP images are accepted');
+
+  // The server names the file, so the client's file name can never reach the file system.
+  const name = `${randomUUID()}.${extension}`;
+  const dir = uploadDir();
+  await mkdir(dir, { recursive: true });
+  await writeFile(join(dir, name), bytes, { flag: 'wx' });
+
+  const avatarUrl = `/uploads/${name}`;
+  await db.user.update({ where: { id: user.id }, data: { avatarUrl } });
+  return Response.json({ avatarUrl });
+}
