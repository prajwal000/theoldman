diff --git a/test/soft-delete.test.ts b/test/soft-delete.test.ts
new file mode 100644
index 0000000..1b5f36b
--- /dev/null
+++ b/test/soft-delete.test.ts
@@ -0,0 +1,53 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET as listOrders, POST as order } from '../src/app/api/orders/route';
+import { DELETE } from '../src/app/api/products/[id]/route';
+import { GET as listProducts } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, params, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('deleting a product', () => {
+  it('keeps past orders and refuses new ones', async () => {
+    const admin = await createUser('ADMIN');
+    const customer = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+    await order(
+      jsonRequest('/api/orders', {
+        body: { productId: product.id, quantity: 1 },
+        token: customer.token,
+      }),
+    );
+
+    const deleted = await DELETE(
+      jsonRequest(`/api/products/${product.id}`, { method: 'DELETE', token: admin.token }),
+      params({ id: product.id }),
+    );
+    expect(deleted.status).toBe(204);
+
+    expect(await (await listProducts()).json()).toEqual([]);
+    const orders = (await (
+      await listOrders(jsonRequest('/api/orders', { token: customer.token }))
+    ).json()) as { product: { name: string } }[];
+    expect(orders.map((o) => o.product.name)).toEqual(['Mug']);
+    const again = await order(
+      jsonRequest('/api/orders', {
+        body: { productId: product.id, quantity: 1 },
+        token: customer.token,
+      }),
+    );
+    expect(again.status).toBe(404);
+  });
+
+  it('gives a 404 for a product that is already deleted', async () => {
+    const admin = await createUser('ADMIN');
+    const product = await db.product.create({
+      data: { name: 'Mug', priceCents: 1200, deletedAt: new Date() },
+    });
+    const response = await DELETE(
+      jsonRequest(`/api/products/${product.id}`, { method: 'DELETE', token: admin.token }),
+      params({ id: product.id }),
+    );
+    expect(response.status).toBe(404);
+  });
+});
