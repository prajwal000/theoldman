+'use client';
+
+import { type FormEvent, useId, useState } from 'react';
+
+export interface SignupResult {
+  readonly token: string;
+  readonly user: { readonly id: string; readonly email: string; readonly name: string };
+}
+
+interface Fields {
+  name: string;
+  email: string;
+  password: string;
+  confirmPassword: string;
+}
+
+type Errors = Partial<Record<keyof Fields, string>>;
+
+const MIN_PASSWORD_LENGTH = 8;
+const EMAIL = /^[^\s@]+@[^\s@]+$/;
+
+// The same rules the signup route applies, checked first so most mistakes need no round trip.
+function validate(fields: Fields): Errors {
+  const errors: Errors = {};
+  if (fields.name.trim() === '') errors.name = 'Enter your name.';
+  if (!EMAIL.test(fields.email.trim())) errors.email = 'Enter a valid email address.';
+  if (fields.password.length < MIN_PASSWORD_LENGTH) {
+    errors.password = `Use at least ${MIN_PASSWORD_LENGTH} characters.`;
+  }
+  if (fields.confirmPassword !== fields.password) {
+    errors.confirmPassword = 'The passwords do not match.';
+  }
+  return errors;
+}
+
+function isSignupResult(value: unknown): value is SignupResult {
+  if (typeof value !== 'object' || value === null) return false;
+  if (!('token' in value) || !('user' in value)) return false;
+  return typeof value.token === 'string' && typeof value.user === 'object' && value.user !== null;
+}
+
+function serverMessage(value: unknown): string {
+  if (typeof value === 'object' && value !== null && 'error' in value) {
+    if (typeof value.error === 'string' && value.error !== '') return value.error;
+  }
+  return 'Sign-up failed. Try again.';
+}
+
+export default function SignupForm({ onSignedUp }: { onSignedUp: (result: SignupResult) => void }) {
+  const id = useId();
+  const [fields, setFields] = useState<Fields>({
+    name: '',
+    email: '',
+    password: '',
+    confirmPassword: '',
+  });
+  const [errors, setErrors] = useState<Errors>({});
+  const [serverError, setServerError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (submitting) return;
+    const found = validate(fields);
+    setErrors(found);
+    if (Object.keys(found).length > 0) return;
+
+    setSubmitting(true);
+    setServerError(null);
+    try {
+      const response = await fetch('/api/auth/signup', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({
+          name: fields.name.trim(),
+          email: fields.email.trim(),
+          password: fields.password,
+        }),
+      });
+      const body: unknown = await response.json().catch(() => null);
+      if (!response.ok || !isSignupResult(body)) {
+        setServerError(serverMessage(body));
+        return;
+      }
+      onSignedUp(body);
+    } catch {
+      setServerError('Could not reach the server. Check your connection and try again.');
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  function field(name: keyof Fields, label: string, type: string, autoComplete: string) {
+    const inputId = `${id}-${name}`;
+    const errorId = `${inputId}-error`;
+    const error = errors[name];
+    return (
+      <p>
+        <label htmlFor={inputId}>{label}</label>
+        <input
+          id={inputId}
+          name={name}
+          type={type}
+          autoComplete={autoComplete}
+          value={fields[name]}
+          onChange={(event) => {
+            setFields({ ...fields, [name]: event.target.value });
+          }}
+          aria-invalid={error === undefined ? undefined : true}
+          aria-describedby={error === undefined ? undefined : errorId}
+        />
+        {error !== undefined && <span id={errorId}>{error}</span>}
+      </p>
+    );
+  }
+
+  return (
+    <form onSubmit={submit} noValidate>
+      {field('name', 'Name', 'text', 'name')}
+      {field('email', 'Email', 'email', 'email')}
+      {field('password', 'Password', 'password', 'new-password')}
+      {field('confirmPassword', 'Confirm password', 'password', 'new-password')}
+      {serverError !== null && <p role="alert">{serverError}</p>}
+      <button type="submit" disabled={submitting}>
+        Sign up
+      </button>
+    </form>
+  );
+}
