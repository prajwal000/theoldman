+// @vitest-environment jsdom
+import { cleanup, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import SignupForm from '../src/components/SignupForm';
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+async function fillIn(values: Partial<Record<string, string>>) {
+  const user = userEvent.setup();
+  for (const [label, value] of Object.entries(values)) {
+    if (value !== undefined && value !== '') await user.type(screen.getByLabelText(label), value);
+  }
+  await user.click(screen.getByRole('button', { name: 'Sign up' }));
+}
+
+const valid = {
+  Name: 'Ada',
+  Email: 'ada@example.com',
+  Password: 'analytical engine',
+  'Confirm password': 'analytical engine',
+};
+
+describe('SignupForm', () => {
+  it('shows errors on the invalid fields and sends nothing', async () => {
+    const fetchMock = vi.fn();
+    vi.stubGlobal('fetch', fetchMock);
+    render(<SignupForm onSignedUp={vi.fn()} />);
+    await fillIn({ ...valid, Email: 'not-an-email', 'Confirm password': 'something else' });
+    expect(screen.getByLabelText('Email').getAttribute('aria-invalid')).toBe('true');
+    expect(screen.getByLabelText('Confirm password').getAttribute('aria-invalid')).toBe('true');
+    expect(screen.getByLabelText('Name').getAttribute('aria-invalid')).toBeNull();
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('signs up and passes the result on', async () => {
+    const result = { token: 't', user: { id: 'u1', email: 'ada@example.com', name: 'Ada' } };
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(Response.json(result, { status: 201 })));
+    const onSignedUp = vi.fn();
+    render(<SignupForm onSignedUp={onSignedUp} />);
+    await fillIn(valid);
+    await vi.waitFor(() => {
+      expect(onSignedUp).toHaveBeenCalledWith(result);
+    });
+  });
+
+  it("shows the server's error", async () => {
+    const response = Response.json({ error: 'email taken' }, { status: 409 });
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(response));
+    render(<SignupForm onSignedUp={vi.fn()} />);
+    await fillIn(valid);
+    expect((await screen.findByRole('alert')).textContent).toContain('email taken');
+  });
+});
