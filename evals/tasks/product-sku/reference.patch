new file mode 100644
index 0000000..e7ef20e
--- /dev/null
+++ b/prisma/migrations/20261127100000_product_sku/migration.sql
@@ -0,0 +1,10 @@
+-- Existing products have no SKU, so the column is added empty, filled, then made required.
+-- Adding it as NOT NULL in one step would fail on any database that already has products.
+ALTER TABLE "Product" ADD COLUMN "sku" TEXT;
+
+UPDATE "Product" SET "sku" = 'LEGACY-' || upper("id") WHERE "sku" IS NULL;
+
+ALTER TABLE "Product" ALTER COLUMN "sku" SET NOT NULL;
+
+-- CreateIndex
+CREATE UNIQUE INDEX "Product_sku_key" ON "Product"("sku");
