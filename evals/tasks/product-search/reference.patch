+++ b/src/app/api/products/search/route.ts
@@ -0,0 +1,48 @@
+import type { Prisma } from '../../../../generated/prisma/client';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+const MAX_RESULTS = 50;
+
+// Sort keys map to fixed orderings, so the query string never reaches the query itself.
+const SORTS: Readonly<Record<string, Prisma.ProductOrderByWithRelationInput[]>> = {
+  newest: [{ createdAt: 'desc' }, { id: 'desc' }],
+  price: [{ priceCents: 'asc' }, { id: 'asc' }],
+  '-price': [{ priceCents: 'desc' }, { id: 'desc' }],
+};
+
+// Prisma passes `contains` to Postgres LIKE as is, where % and _ are wildcards. Escaping them
+// (and the backslash, LIKE's default escape character) makes them match literally.
+const likeLiteral = (text: string): string => text.replace(/[\\%_]/g, '\\$&');
+
+/** A whole number of cents from a query parameter: undefined when absent, null when invalid. */
+function cents(value: string | null): number | null | undefined {
+  if (value === null) return undefined;
+  return /^\d+$/.test(value) ? Number(value) : null;
+}
+
+export async function GET(request: Request): Promise<Response> {
+  const query = new URL(request.url).searchParams;
+  const minPrice = cents(query.get('minPrice'));
+  const maxPrice = cents(query.get('maxPrice'));
+  if (minPrice === null || maxPrice === null) {
+    return jsonError(400, 'minPrice and maxPrice must be whole, non-negative cents');
+  }
+  if (minPrice !== undefined && maxPrice !== undefined && minPrice > maxPrice) {
+    return jsonError(400, 'minPrice must not be above maxPrice');
+  }
+  const sortKey = query.get('sort') ?? 'newest';
+  const orderBy = Object.hasOwn(SORTS, sortKey) ? SORTS[sortKey] : undefined;
+  if (orderBy === undefined) return jsonError(400, 'sort must be newest, price or -price');
+
+  const q = query.get('q')?.trim() ?? '';
+  const items = await db.product.findMany({
+    where: {
+      ...(q === '' ? {} : { name: { contains: likeLiteral(q), mode: 'insensitive' } }),
+      priceCents: { gte: minPrice, lte: maxPrice },
+    },
+    orderBy,
+    take: MAX_RESULTS,
+  });
+  return Response.json({ items });
+}
