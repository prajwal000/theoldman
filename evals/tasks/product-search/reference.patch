@@ -0,0 +1,59 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/products/search/route';
+import { db } from '../src/lib/db';
+import { jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+async function search(query: string): Promise<{ status: number; names: string[] }> {
+  const response = await GET(jsonRequest(`/api/products/search?${query}`));
+  if (response.status !== 200) return { status: response.status, names: [] };
+  const body = (await response.json()) as { items: { name: string }[] };
+  return { status: 200, names: body.items.map((item) => item.name) };
+}
+
+async function seed(products: [string, number][]): Promise<void> {
+  await db.product.createMany({
+    data: products.map(([name, priceCents], i) => ({
+      name,
+      priceCents,
+      createdAt: new Date(1_000_000 + i * 1000),
+    })),
+  });
+}
+
+describe('product search', () => {
+  it('matches names case-insensitively, with % and _ taken literally', async () => {
+    await seed([
+      ['Blue MUG', 1200],
+      ['Teapot', 2500],
+      ['100% cotton tee', 1500],
+      ['100 cotton tee', 1400],
+      ['a_b', 100],
+      ['axb', 100],
+    ]);
+    expect((await search('q=mug')).names).toEqual(['Blue MUG']);
+    expect((await search(`q=${encodeURIComponent('100%')}`)).names).toEqual(['100% cotton tee']);
+    expect((await search('q=a_b')).names).toEqual(['a_b']);
+  });
+
+  it('filters by price and sorts', async () => {
+    await seed([
+      ['Cheap', 100],
+      ['Middle', 500],
+      ['Dear', 900],
+    ]);
+    expect((await search('minPrice=500&maxPrice=900&sort=price')).names).toEqual([
+      'Middle',
+      'Dear',
+    ]);
+    expect((await search('sort=-price')).names).toEqual(['Dear', 'Middle', 'Cheap']);
+    expect((await search('')).names).toEqual(['Dear', 'Middle', 'Cheap']);
+  });
+
+  it('rejects bad parameters', async () => {
+    for (const query of ['minPrice=abc', 'maxPrice=-1', 'minPrice=9&maxPrice=1', 'sort=name']) {
+      expect((await search(query)).status).toBe(400);
+    }
+  });
+});
