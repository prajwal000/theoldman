@@ -1,16 +1,30 @@
 import { createSession, publicUser, verifyPassword } from '../../../../lib/auth';
 import { db } from '../../../../lib/db';
 import { isRecord, jsonError, readJson } from '../../../../lib/http';
+import { clearFailures, lockedForSeconds, recordFailure } from '../../../../lib/login-limit';
 
 export async function POST(request: Request): Promise<Response> {
   const body = await readJson(request);
   if (!isRecord(body) || typeof body.email !== 'string' || typeof body.password !== 'string') {
     return jsonError(400, 'email and password are required');
   }
-  const user = await db.user.findUnique({ where: { email: body.email.trim().toLowerCase() } });
+  const email = body.email.trim().toLowerCase();
+
+  // Checked before the password, so a locked account gives nothing away even to the right guess.
+  const wait = await lockedForSeconds(email);
+  if (wait > 0) {
+    return Response.json(
+      { error: 'too many failed sign-ins; try again later' },
+      { status: 429, headers: { 'Retry-After': String(wait) } },
+    );
+  }
+
+  const user = await db.user.findUnique({ where: { email } });
   if (user === null || !(await verifyPassword(body.password, user.passwordHash))) {
+    await recordFailure(email);
     return jsonError(401, 'wrong email or password');
   }
+  await clearFailures(email);
   const token = await createSession(user.id);
   return Response.json({ token, user: publicUser(user) });
 }
diff --git a/src/lib/login-limit.ts b/src/lib/login-limit.ts
new file mode 100644
index 0000000..a39af6d
--- /dev/null
+++ b/src/lib/login-limit.ts
@@ -0,0 +1,30 @@
+// Limits password guessing: after MAX_FAILURES failed sign-ins for one email within WINDOW_MS,
+// further attempts are refused until the oldest of those failures is older than the window.
+// Failures live in the database, so the limit holds across app servers.
+
+import { db } from './db';
+
+export const MAX_FAILURES = 5;
+export const WINDOW_MS = 15 * 60 * 1000;
+
+/** Seconds until the email may try again, or 0 when it may try now. */
+export async function lockedForSeconds(email: string): Promise<number> {
+  const since = new Date(Date.now() - WINDOW_MS);
+  const recent = await db.loginAttempt.findMany({
+    where: { email, createdAt: { gt: since } },
+    orderBy: { createdAt: 'desc' },
+    take: MAX_FAILURES,
+    select: { createdAt: true },
+  });
+  const oldest = recent.at(-1);
+  if (recent.length < MAX_FAILURES || oldest === undefined) return 0;
+  return Math.max(1, Math.ceil((oldest.createdAt.getTime() + WINDOW_MS - Date.now()) / 1000));
+}
+
+export async function recordFailure(email: string): Promise<void> {
+  await db.loginAttempt.create({ data: { email } });
+}
+
+export async function clearFailures(email: string): Promise<void> {
+  await db.loginAttempt.deleteMany({ where: { email } });
+}
diff --git a/test/login-limit.test.ts b/test/login-limit.test.ts
new file mode 100644
index 0000000..1c29e67
--- /dev/null
+++ b/test/login-limit.test.ts
@@ -0,0 +1,37 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { POST as login } from '../src/app/api/auth/login/route';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+const attempt = (email: string, password: string) =>
+  login(jsonRequest('/api/auth/login', { body: { email, password } }));
+
+describe('login rate limit', () => {
+  it('locks an email after five failures, even for the right password, until the window ends', async () => {
+    const { user } = await createUser('CUSTOMER', 'the right password');
+    for (let i = 0; i < 5; i++) expect((await attempt(user.email, 'wrong')).status).toBe(401);
+    const locked = await attempt(user.email, 'the right password');
+    expect(locked.status).toBe(429);
+    expect(Number(locked.headers.get('retry-after'))).toBeGreaterThan(0);
+
+    vi.useFakeTimers({ toFake: ['Date'] });
+    vi.setSystemTime(Date.now() + 16 * 60 * 1000);
+    expect((await attempt(user.email, 'the right password')).status).toBe(200);
+  });
+
+  it('clears the failures after a successful sign-in', async () => {
+    const { user } = await createUser('CUSTOMER', 'the right password');
+    for (let i = 0; i < 4; i++) await attempt(user.email, 'wrong');
+    expect((await attempt(user.email, 'the right password')).status).toBe(200);
+    for (let i = 0; i < 4; i++) expect((await attempt(user.email, 'wrong')).status).toBe(401);
+  });
+
+  it('limits unknown emails and ignores case', async () => {
+    for (let i = 0; i < 5; i++) await attempt('Nobody@Example.com', 'guess');
+    expect((await attempt('nobody@example.com', 'guess')).status).toBe(429);
+  });
+});
