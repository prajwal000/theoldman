new file mode 100644
index 0000000..8da11f2
--- /dev/null
+++ b/src/lib/config.ts
@@ -0,0 +1,14 @@
+const DEFAULT_SESSION_DAYS = 30;
+
+/**
+ * How long a session lasts, in days: SESSION_TTL_DAYS, or 30 when it is not set. Any other value
+ * throws, because guessing a lifetime for a security setting is worse than failing loudly.
+ */
+export function sessionLifetimeDays(): number {
+  const value = process.env.SESSION_TTL_DAYS;
+  if (value === undefined || value === '') return DEFAULT_SESSION_DAYS;
+  if (!/^\d+$/.test(value) || Number(value) < 1) {
+    throw new Error(`SESSION_TTL_DAYS must be a positive whole number of days, not "${value}".`);
+  }
+  return Number(value);
+}
diff --git a/test/session-lifetime.test.ts b/test/session-lifetime.test.ts
new file mode 100644
index 0000000..e9560bf
--- /dev/null
+++ b/test/session-lifetime.test.ts
@@ -0,0 +1,40 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { POST as login } from '../src/app/api/auth/login/route';
+import { sessionLifetimeDays } from '../src/lib/config';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+beforeEach(resetDatabase);
+afterEach(() => {
+  delete process.env.SESSION_TTL_DAYS;
+});
+
+describe('session lifetime', () => {
+  it('defaults to 30 days and follows SESSION_TTL_DAYS', () => {
+    expect(sessionLifetimeDays()).toBe(30);
+    process.env.SESSION_TTL_DAYS = '7';
+    expect(sessionLifetimeDays()).toBe(7);
+  });
+
+  it.each(['0', '-1', 'abc', '2.5', '7 days'])('refuses SESSION_TTL_DAYS=%s', (value) => {
+    process.env.SESSION_TTL_DAYS = value;
+    expect(() => sessionLifetimeDays()).toThrow('SESSION_TTL_DAYS must be a positive whole number');
+  });
+
+  it('gives a new session the configured lifetime', async () => {
+    const { user } = await createUser('CUSTOMER', 'long enough password');
+    await db.session.deleteMany();
+    process.env.SESSION_TTL_DAYS = '7';
+    const response = await login(
+      jsonRequest('/api/auth/login', {
+        body: { email: user.email, password: 'long enough password' },
+      }),
+    );
+    expect(response.status).toBe(200);
+    const session = await db.session.findFirstOrThrow({ where: { userId: user.id } });
+    expect(session.expiresAt.getTime() - Date.now()).toBeGreaterThan(7 * DAY_MS - 60_000);
+    expect(session.expiresAt.getTime() - Date.now()).toBeLessThanOrEqual(7 * DAY_MS);
+  });
+});
