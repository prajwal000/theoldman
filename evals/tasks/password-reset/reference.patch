diff --git a/test/password-reset.test.ts b/test/password-reset.test.ts
new file mode 100644
index 0000000..c0feb4f
--- /dev/null
+++ b/test/password-reset.test.ts
@@ -0,0 +1,69 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { POST as login } from '../src/app/api/auth/login/route';
+import { POST as confirmReset } from '../src/app/api/auth/password-reset/confirm/route';
+import { POST as requestReset } from '../src/app/api/auth/password-reset/request/route';
+import { GET as me } from '../src/app/api/users/me/route';
+import { outbox } from '../src/lib/email';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(async () => {
+  await resetDatabase();
+  outbox.length = 0;
+});
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+async function sendResetLink(email: string): Promise<string> {
+  await requestReset(jsonRequest('/api/auth/password-reset/request', { body: { email } }));
+  const token = /token=([\w-]+)/.exec(outbox.at(-1)?.text ?? '')?.[1];
+  if (token === undefined) throw new Error('no reset link was sent');
+  return token;
+}
+
+const confirmRequest = (token: string, password: string) =>
+  confirmReset(jsonRequest('/api/auth/password-reset/confirm', { body: { token, password } }));
+
+describe('password reset', () => {
+  it('resets the password and signs out existing sessions', async () => {
+    const { user, token: session } = await createUser();
+    const token = await sendResetLink(user.email);
+
+    expect((await confirmRequest(token, 'a brand new password')).status).toBe(200);
+    const signIn = { email: user.email, password: 'a brand new password' };
+    expect((await login(jsonRequest('/api/auth/login', { body: signIn }))).status).toBe(200);
+    expect((await me(jsonRequest('/api/users/me', { token: session }))).status).toBe(401);
+  });
+
+  it('gives the same answer for an unknown email and sends nothing', async () => {
+    const { user } = await createUser();
+    const known = await requestReset(
+      jsonRequest('/api/auth/password-reset/request', { body: { email: user.email } }),
+    );
+    const unknown = await requestReset(
+      jsonRequest('/api/auth/password-reset/request', { body: { email: 'nobody@example.com' } }),
+    );
+    expect([unknown.status, await unknown.json()]).toEqual([known.status, await known.json()]);
+    expect(outbox).toHaveLength(1);
+  });
+
+  it('accepts a token once and not after an hour', async () => {
+    const { user } = await createUser();
+    const used = await sendResetLink(user.email);
+    expect((await confirmRequest(used, 'first new password')).status).toBe(200);
+    expect((await confirmRequest(used, 'second new password')).status).toBe(400);
+
+    const late = await sendResetLink(user.email);
+    vi.useFakeTimers({ toFake: ['Date'] });
+    vi.setSystemTime(Date.now() + 61 * 60 * 1000);
+    expect((await confirmRequest(late, 'too late password')).status).toBe(400);
+  });
+
+  it('rejects an unknown token and a short password', async () => {
+    const { user } = await createUser();
+    const token = await sendResetLink(user.email);
+    expect((await confirmRequest('made-up', 'long enough password')).status).toBe(400);
+    expect((await confirmRequest(token, 'short')).status).toBe(400);
+    expect((await confirmRequest(token, 'long enough password')).status).toBe(200);
+  });
+});
