diff --git a/src/app/api/auth/password-reset/confirm/route.ts b/src/app/api/auth/password-reset/confirm/route.ts
new file mode 100644
index 0000000..fcea7cd
--- /dev/null
+++ b/src/app/api/auth/password-reset/confirm/route.ts
@@ -0,0 +1,40 @@
+import { hashPassword, hashToken, MIN_PASSWORD_LENGTH } from '../../../../../lib/auth';
+import { db } from '../../../../../lib/db';
+import { isRecord, jsonError, readJson } from '../../../../../lib/http';
+
+export async function POST(request: Request): Promise<Response> {
+  const body = await readJson(request);
+  if (!isRecord(body) || typeof body.token !== 'string' || typeof body.password !== 'string') {
+    return jsonError(400, 'token and password are required');
+  }
+  if (body.password.length < MIN_PASSWORD_LENGTH) {
+    return jsonError(400, `password must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+
+  const tokenHash = hashToken(body.token);
+  const passwordHash = await hashPassword(body.password);
+  const now = new Date();
+  const userId = await db.$transaction(async (tx) => {
+    const token = await tx.passwordResetToken.findUnique({ where: { tokenHash } });
+    if (token === null || token.usedAt !== null || token.expiresAt <= now) return null;
+    // Claiming the token with a conditional update keeps it single-use under concurrent requests.
+    const claimed = await tx.passwordResetToken.updateMany({
+      where: { id: token.id, usedAt: null },
+      data: { usedAt: now },
+    });
+    if (claimed.count === 0) return null;
+
+    await tx.user.update({ where: { id: token.userId }, data: { passwordHash } });
+    // A reset is often a response to a stolen password: sign out everywhere and retire any other
+    // links that were sent.
+    await tx.session.deleteMany({ where: { userId: token.userId } });
+    await tx.passwordResetToken.updateMany({
+      where: { userId: token.userId, usedAt: null },
+      data: { usedAt: now },
+    });
+    return token.userId;
+  });
+
+  if (userId === null) return jsonError(400, 'this reset link is invalid or has expired');
+  return Response.json({ message: 'Your password has been reset. Sign in with the new password.' });
+}
diff --git a/src/app/api/auth/password-reset/request/route.ts b/src/app/api/auth/password-reset/request/route.ts
new file mode 100644
index 0000000..6df28fb
--- /dev/null
+++ b/src/app/api/auth/password-reset/request/route.ts
@@ -0,0 +1,37 @@
+import { randomBytes } from 'node:crypto';
+import { hashToken } from '../../../../../lib/auth';
+import { appUrl } from '../../../../../lib/config';
+import { db } from '../../../../../lib/db';
+import { sendEmail } from '../../../../../lib/email';
+import { isRecord, jsonError, readJson } from '../../../../../lib/http';
+
+const TOKEN_LIFETIME_MS = 60 * 60 * 1000;
+
+// The same answer whether or not the account exists, so this route cannot reveal who has one.
+const ACCEPTED = { message: 'If an account exists for that email, a reset link is on its way.' };
+
+export async function POST(request: Request): Promise<Response> {
+  const body = await readJson(request);
+  if (!isRecord(body) || typeof body.email !== 'string') {
+    return jsonError(400, 'email is required');
+  }
+
+  const user = await db.user.findUnique({ where: { email: body.email.trim().toLowerCase() } });
+  if (user !== null) {
+    const token = randomBytes(32).toString('base64url');
+    await db.passwordResetToken.create({
+      data: {
+        userId: user.id,
+        tokenHash: hashToken(token),
+        expiresAt: new Date(Date.now() + TOKEN_LIFETIME_MS),
+      },
+    });
+    const link = new URL(`/reset-password?token=${token}`, appUrl()).href;
+    await sendEmail({
+      to: user.email,
+      subject: 'Reset your password',
+      text: `Reset your password here: ${link}\n\nThe link works once and expires in one hour. If you did not ask for it, you can ignore this email.`,
+    });
+  }
+  return Response.json(ACCEPTED);
+}
