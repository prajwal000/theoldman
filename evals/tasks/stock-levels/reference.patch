diff --git a/test/stock.test.ts b/test/stock.test.ts
new file mode 100644
index 0000000..27e2cd4
--- /dev/null
+++ b/test/stock.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { POST as placeOrder } from '../src/app/api/orders/route';
+import { POST as addProduct } from '../src/app/api/products/route';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+const order = (token: string, productId: string, quantity: number) =>
+  placeOrder(jsonRequest('/api/orders', { body: { productId, quantity }, token }));
+
+describe('stock', () => {
+  it('sets stock on new products and rejects bad values', async () => {
+    const { token } = await createUser('ADMIN');
+    const add = (body: Record<string, unknown>) =>
+      addProduct(
+        jsonRequest('/api/products', { body: { name: 'Mug', priceCents: 1, ...body }, token }),
+      );
+    expect(await (await add({ stock: 5 })).json()).toMatchObject({ stock: 5 });
+    expect(await (await add({})).json()).toMatchObject({ stock: 0 });
+    expect((await add({ stock: -1 })).status).toBe(400);
+    expect((await add({ stock: 1.5 })).status).toBe(400);
+  });
+
+  it('takes stock when ordering and refuses more than is left', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1, stock: 5 } });
+    expect((await order(token, product.id, 2)).status).toBe(201);
+    expect((await order(token, product.id, 4)).status).toBe(409);
+    expect((await db.product.findUniqueOrThrow({ where: { id: product.id } })).stock).toBe(3);
+    expect(await db.order.count()).toBe(1);
+  });
+
+  it('never sells more than is in stock under concurrent orders', async () => {
+    const { token } = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug', priceCents: 1, stock: 3 } });
+    const statuses = await Promise.all(
+      Array.from({ length: 10 }, async () => (await order(token, product.id, 1)).status),
+    );
+    expect(statuses.filter((status) => status === 201)).toHaveLength(3);
+    expect((await db.product.findUniqueOrThrow({ where: { id: product.id } })).stock).toBe(0);
+  });
+});
