new file mode 100644
index 0000000..e5648b9
--- /dev/null
+++ b/src/lib/cursor.ts
@@ -0,0 +1,25 @@
+export interface ProductCursor {
+  readonly createdAt: Date;
+  readonly id: string;
+}
+
+// The cursor holds the last item's (createdAt, id) rather than its id alone, so pages stay in
+// order when products share a timestamp, and a cursor keeps working if its product is deleted.
+export function encodeCursor({ createdAt, id }: ProductCursor): string {
+  return Buffer.from(JSON.stringify([createdAt.toISOString(), id])).toString('base64url');
+}
+
+/** The cursor's position, or null when it was not made by encodeCursor. */
+export function decodeCursor(cursor: string): ProductCursor | null {
+  let value: unknown;
+  try {
+    value = JSON.parse(Buffer.from(cursor, 'base64url').toString('utf8'));
+  } catch {
+    return null;
+  }
+  if (!Array.isArray(value) || value.length !== 2) return null;
+  const [createdAt, id]: unknown[] = value;
+  if (typeof createdAt !== 'string' || typeof id !== 'string') return null;
+  const date = new Date(createdAt);
+  return Number.isNaN(date.getTime()) ? null : { createdAt: date, id };
+}
