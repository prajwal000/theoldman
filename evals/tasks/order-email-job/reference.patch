+  DONE
+  FAILED
+}
+
+/// Work done outside a request, such as sending email. See src/lib/jobs.ts.
+model Job {
+  id        String    @id @default(cuid())
+  type      String
+  payload   Json
+  status    JobStatus @default(PENDING)
+  attempts  Int       @default(0)
+  runAt     DateTime  @default(now())
+  lastError String?
+  createdAt DateTime  @default(now())
+
+  @@index([status, runAt])
+}
+
