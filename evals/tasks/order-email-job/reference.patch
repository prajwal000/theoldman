--- /dev/null
+++ b/scripts/worker.ts
@@ -0,0 +1,23 @@
+// Runs due jobs every few seconds until stopped. Start it with `npm run worker`; run as many as
+// needed, since jobs are claimed with row locks.
+
+import { runDueJobs } from '../src/lib/jobs';
+
+const POLL_MS = 2000;
+let stopping = false;
+
+for (const signal of ['SIGINT', 'SIGTERM'] as const) {
+  process.on(signal, () => {
+    stopping = true;
+  });
+}
+
+while (!stopping) {
+  try {
+    const ran = await runDueJobs();
+    if (ran > 0) console.log(`ran ${String(ran)} job(s)`);
+  } catch (error) {
+    console.error('job run failed:', error);
+  }
+  await new Promise((resolve) => setTimeout(resolve, POLL_MS));
+}
