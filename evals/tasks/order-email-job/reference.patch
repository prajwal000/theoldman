diff --git a/src/lib/jobs.ts b/src/lib/jobs.ts
new file mode 100644
index 0000000..8278c0d
--- /dev/null
+++ b/src/lib/jobs.ts
@@ -0,0 +1,104 @@
+// A small job queue in Postgres. Jobs are rows in "Job"; runDueJobs claims due ones with
+// FOR UPDATE SKIP LOCKED, so any number of workers can run at once and each job runs once.
+// A failed job is retried after JOB_RETRY_DELAY_MS, up to MAX_ATTEMPTS, then kept as FAILED with
+// its last error for someone to look at.
+
+import type { Prisma } from '../generated/prisma/client';
+import { db } from './db';
+import { sendEmail } from './email';
+
+export const MAX_ATTEMPTS = 3;
+const DEFAULT_RETRY_DELAY_MS = 60_000;
+
+type Handler = (payload: unknown) => Promise<void>;
+
+interface ClaimedJob {
+  readonly id: string;
+  readonly type: string;
+  readonly payload: unknown;
+  readonly attempts: number;
+}
+
+function retryDelayMs(): number {
+  const value = process.env.JOB_RETRY_DELAY_MS;
+  if (value === undefined || value === '') return DEFAULT_RETRY_DELAY_MS;
+  if (!/^\d+$/.test(value)) {
+    throw new Error(`JOB_RETRY_DELAY_MS must be a whole number of milliseconds, not "${value}".`);
+  }
+  return Number(value);
+}
+
+async function sendOrderConfirmation(payload: unknown): Promise<void> {
+  const orderId =
+    typeof payload === 'object' && payload !== null && 'orderId' in payload
+      ? payload.orderId
+      : undefined;
+  if (typeof orderId !== 'string') throw new Error('order-confirmation job has no orderId');
+  const order = await db.order.findUnique({
+    where: { id: orderId },
+    include: { user: true, product: true },
+  });
+  // The order can be gone by the time the job runs; there is no one left to email.
+  if (order === null) return;
+  await sendEmail({
+    to: order.user.email,
+    subject: 'Your order is confirmed',
+    text: `Thanks for your order of ${String(order.quantity)} x ${order.product.name} (order ${order.id}). Total: ${(order.totalCents / 100).toFixed(2)}.`,
+  });
+}
+
+type JobType = 'order-confirmation';
+
+// A Map, not an object: a type read from the database can never reach a prototype method.
+const HANDLERS: ReadonlyMap<string, Handler> = new Map<JobType, Handler>([
+  ['order-confirmation', sendOrderConfirmation],
+]);
+
+/** Queues a job. Pass the transaction that makes the change the job is about, so both commit together. */
+export async function enqueue(
+  client: Prisma.TransactionClient,
+  type: JobType,
+  payload: Prisma.InputJsonObject,
+): Promise<void> {
+  await client.job.create({ data: { type, payload } });
+}
+
+/** Runs one due job, if there is one; false when none was due. */
+async function runOne(): Promise<boolean> {
+  return db.$transaction(async (tx) => {
+    const [job] = await tx.$queryRaw<ClaimedJob[]>`
+      SELECT id, type, payload, attempts FROM "Job"
+      WHERE status = 'PENDING' AND "runAt" <= ${new Date()}
+      ORDER BY "runAt"
+      LIMIT 1
+      FOR UPDATE SKIP LOCKED`;
+    if (job === undefined) return false;
+
+    const attempts = job.attempts + 1;
+    try {
+      const handler = HANDLERS.get(job.type);
+      if (handler === undefined) throw new Error(`no handler for job type "${job.type}"`);
+      await handler(job.payload);
+      await tx.job.update({ where: { id: job.id }, data: { status: 'DONE', attempts } });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      await tx.job.update({
+        where: { id: job.id },
+        data: {
+          attempts,
+          lastError: message,
+          status: attempts >= MAX_ATTEMPTS ? 'FAILED' : 'PENDING',
+          runAt: new Date(Date.now() + retryDelayMs()),
+        },
+      });
+    }
+    return true;
+  });
+}
+
+/** Runs jobs until none is due, and returns how many it ran. */
+export async function runDueJobs(): Promise<number> {
+  let ran = 0;
+  while (await runOne()) ran += 1;
+  return ran;
+}
diff --git a/test/jobs.test.ts b/test/jobs.test.ts
new file mode 100644
index 0000000..ebfedaf
--- /dev/null
+++ b/test/jobs.test.ts
@@ -0,0 +1,58 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { POST as placeOrder } from '../src/app/api/orders/route';
+import { db } from '../src/lib/db';
+import { outbox } from '../src/lib/email';
+import { MAX_ATTEMPTS, runDueJobs } from '../src/lib/jobs';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+const push = outbox.push.bind(outbox);
+
+beforeEach(async () => {
+  await resetDatabase();
+  outbox.length = 0;
+  process.env.JOB_RETRY_DELAY_MS = '0';
+});
+afterEach(() => {
+  outbox.push = push;
+  delete process.env.JOB_RETRY_DELAY_MS;
+});
+
+async function order(): Promise<string> {
+  const { token, user } = await createUser();
+  const product = await db.product.create({ data: { name: 'Mug', priceCents: 1200 } });
+  const response = await placeOrder(
+    jsonRequest('/api/orders', { body: { productId: product.id, quantity: 1 }, token }),
+  );
+  expect(response.status).toBe(201);
+  return user.email;
+}
+
+describe('order confirmation job', () => {
+  it('emails the confirmation from the job, not the request, and only once', async () => {
+    const email = await order();
+    expect(outbox).toHaveLength(0);
+    expect(await runDueJobs()).toBe(1);
+    expect(await runDueJobs()).toBe(0);
+    expect(outbox.map((sent) => sent.to)).toEqual([email]);
+  });
+
+  it('runs each job once when workers run at the same time', async () => {
+    for (let i = 0; i < 4; i++) await order();
+    await Promise.all([runDueJobs(), runDueJobs(), runDueJobs()]);
+    expect(outbox).toHaveLength(4);
+  });
+
+  it('retries a failed job and gives up after the last attempt', async () => {
+    await order();
+    let calls = 0;
+    outbox.push = () => {
+      calls += 1;
+      throw new Error('mail provider down');
+    };
+    await runDueJobs();
+    await runDueJobs();
+    expect(calls).toBe(MAX_ATTEMPTS);
+    const job = await db.job.findFirstOrThrow();
+    expect(job).toMatchObject({ status: 'FAILED', lastError: 'mail provider down' });
+  });
+});
