+import { beforeEach, describe, expect, it } from 'vitest';
+import { GET } from '../src/app/api/orders/export/route';
+import { csvField, toCsv } from '../src/lib/csv';
+import { db } from '../src/lib/db';
+import { createUser, jsonRequest, resetDatabase } from './helpers';
+
+beforeEach(resetDatabase);
+
+describe('csv', () => {
+  it('quotes commas, quotes and line breaks', () => {
+    expect(csvField('plain')).toBe('plain');
+    expect(csvField('a,b')).toBe('"a,b"');
+    expect(csvField('say "hi"')).toBe('"say ""hi"""');
+    expect(csvField('two\nlines')).toBe('"two\nlines"');
+    expect(
+      toCsv([
+        ['a', 1],
+        ['b', 2],
+      ]),
+    ).toBe('a,1\r\nb,2\r\n');
+  });
+
+  it('keeps spreadsheets from running text as a formula', () => {
+    expect(csvField('=1+1')).toBe("'=1+1");
+    expect(csvField('@SUM(A1)')).toBe("'@SUM(A1)");
+    expect(csvField('-2')).toBe("'-2");
+    expect(csvField('+cmd')).toBe("'+cmd");
+    expect(csvField(-2)).toBe('-2');
+  });
+});
+
+describe('order export', () => {
+  it("exports the signed-in customer's orders, newest first", async () => {
+    const { user, token } = await createUser();
+    const other = await createUser();
+    const product = await db.product.create({ data: { name: 'Mug, large', priceCents: 1205 } });
+    await db.order.create({
+      data: {
+        userId: user.id,
+        productId: product.id,
+        quantity: 2,
+        totalCents: 2410,
+        createdAt: new Date('2026-01-02T03:04:05.000Z'),
+      },
+    });
+    await db.order.create({
+      data: { userId: other.user.id, productId: product.id, quantity: 1, totalCents: 1205 },
+    });
+
+    const response = await GET(jsonRequest('/api/orders/export', { token }));
+    expect(response.headers.get('content-type')).toMatch(/^text\/csv/);
+    expect(response.headers.get('content-disposition')).toBe('attachment; filename="orders.csv"');
+    const lines = (await response.text()).trimEnd().split('\r\n');
+    expect(lines[0]).toBe('order_id,date,product,quantity,total,status');
+    expect(lines).toHaveLength(2);
+    expect(lines[1]).toMatch(/,2026-01-02T03:04:05\.000Z,"Mug, large",2,24\.10,PENDING$/);
+  });
+});
