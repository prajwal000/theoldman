+import { getCurrentUser } from '../../../../lib/auth';
+import { toCsv } from '../../../../lib/csv';
+import { db } from '../../../../lib/db';
+import { jsonError } from '../../../../lib/http';
+
+const HEADER = ['order_id', 'date', 'product', 'quantity', 'total', 'status'];
+
+export async function GET(request: Request): Promise<Response> {
+  const user = await getCurrentUser(request);
+  if (user === null) return jsonError(401, 'sign in first');
+
+  const orders = await db.order.findMany({
+    where: { userId: user.id },
+    include: { product: { select: { name: true } } },
+    orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
+  });
+  const rows = orders.map((order) => [
+    order.id,
+    order.createdAt.toISOString(),
+    order.product.name,
+    order.quantity,
+    // Integer cents to a fixed two-decimal string, with no floating-point rounding on the way.
+    `${String(Math.trunc(order.totalCents / 100))}.${String(order.totalCents % 100).padStart(2, '0')}`,
+    order.status,
+  ]);
+  return new Response(toCsv([HEADER, ...rows]), {
+    headers: {
+      'Content-Type': 'text/csv; charset=utf-8',
+      'Content-Disposition': 'attachment; filename="orders.csv"',
+      'Cache-Control': 'private, no-store',
+    },
+  });
+}
